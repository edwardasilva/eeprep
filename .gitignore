*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz

# Cover figure build: downloaded fonts and TeX intermediates
.cache/
src/figures/**/*.aux
src/figures/**/*.log
src/figures/**/*.xdv
src/figures/**/*.raw.svg

# Local Wrangler state
.wrangler/
