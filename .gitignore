# Dependencies and build output
node_modules/
dist/
.astro/

# Secrets
.env*
!.env.example

# Logs and test coverage
*.log
logs/
coverage/
.nyc_output/

# OS files
.DS_Store

# Editors. Shared VS Code settings can still be committed.
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# Obsidian vault UI state. app.json is shared on purpose.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# LaTeX build artifacts. Keep .tex sources and PDFs, including a public resume.
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
