---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { externalLinks } from '../components/resume/caption';
import HomeCoverFigure from '../components/home/HomeCoverFigure.astro';
import { homeDescription, homeTitle } from '../lib/home';

// Like links in the guide text, the GitHub link opens in a new tab with the
// external-link arrow.
const generatorLink = externalLinks(
	'<a href="https://github.com/edwardasilva/resume-generator">resume-generator</a>',
);
---

<StarlightPage
	frontmatter={{
		title: 'eeprep',
		description: homeDescription,
		head: [
			{
				tag: 'title',
				content: `${homeTitle} | eeprep`,
			},
		],
		template: 'splash',
		pagefind: false,
	}}
	hasSidebar={false}
>
	<section class="eep-hero">
		<h1 id="_top" tabindex="-1">
			{homeTitle}
		</h1>
		<p>
			This free guide is for electrical engineering and computer science (EECS)
			students and new graduates looking for an internship or a first job in the
			US. A working embedded engineer wrote it and linked the sources
			throughout.
		</p>
	</section>
	<div class="eep-home">
		<ul class="eep-cards">
			<li>
				<a href="/help/">
					<strong>Help</strong>
					<span>
						Links to job boards, pay data, and other sites for your job search.
					</span>
				</a>
			</li>
			<li>
				<a href="/advice/">
					<strong>Advice</strong>
					<span>
						How to pick projects that count, write a one-page resume, and get
						hired.
					</span>
				</a>
			</li>
		</ul>
		<HomeCoverFigure />
		<div class="eep-home-main">
			<p>
				New here?{' '}
				<a href="/advice/resume/quick-setup/">The whole guide on one page</a>{' '}
				takes five minutes.
			</p>
			<p>
				Ask for a referral before you apply, whenever you can. The{' '}
				<a href="/advice/getting-hired/#get-a-referral-first">
					section on getting a referral first
				</a>{' '}
				says how to ask.
			</p>
			<p>
				The <a href="/roadmap/">roadmap</a> lists what is coming next.
			</p>
			<p class="eep-generator">
				<Fragment set:html={generatorLink} /> is a free, open-source tool that
				turns one file into a one-page PDF, so you don't have to format a resume
				by hand.
			</p>
		</div>
	</div>
</StarlightPage>
