---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: 'eeprep',
		description:
			"Electrical engineer's guide to job searching: a one-page resume, a first internship and help links for the search.",
		head: [
			{
				tag: 'title',
				content: "Electrical engineer's guide to job searching | eeprep",
			},
		],
		template: 'splash',
		pagefind: false,
	}}
	hasSidebar={false}
>
	<section class="eep-hero">
		<h1>Electrical engineer's guide to job searching</h1>
	</section>
	<ul class="eep-cards">
		<li>
			<a href="/help-links/">
				<strong>Help links</strong>
				<span>
					Links to job boards, salary data and other sites for your job
					search.
				</span>
			</a>
		</li>
		<li>
			<a href="/advice/resume/">
				<strong>Advice</strong>
				<span>
					How to write a one-page resume and land your first internship.
				</span>
			</a>
		</li>
	</ul>
	<p>
		Before you apply anywhere, try to get a referral first.{' '}
		<a href="/advice/first-internship/#get-a-referral-first">
			Here is how to ask
		</a>
		.
	</p>
	<p>
		<a href="/roadmap/">Roadmap</a>
	</p>
	<p class="eep-generator">
		Want a resume without formatting it by hand?{' '}
		<a href="https://github.com/edwardasilva/resume-generator">
			resume-generator
		</a>{' '}
		is a free, open-source tool that turns one file into a one-page PDF.
	</p>
</StarlightPage>
