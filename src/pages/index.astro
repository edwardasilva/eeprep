---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { externalLinks } from '../components/resume/caption';
import HomeCoverFigure from '../components/home/HomeCoverFigure.astro';

// Like links in the guide text, the GitHub link opens in a new tab with the
// external-link arrow.
const generatorLink = externalLinks(
	'<a href="https://github.com/edwardasilva/resume-generator">resume-generator</a>',
);
---

<StarlightPage
	frontmatter={{
		title: 'eeprep',
		description:
			'A guide to job searching for electrical engineers & computer scientists: a one-page resume, getting hired for an internship or a first full-time role, and help with the search.',
		head: [
			{
				tag: 'title',
				content:
					'A guide to job searching for electrical engineers & computer scientists | eeprep',
			},
		],
		template: 'splash',
		pagefind: false,
	}}
	hasSidebar={false}
>
	<section class="eep-hero">
		<h1>
			A guide to job searching for electrical engineers & computer scientists
		</h1>
		<p>
			For EECS students looking for a first job: a free guide written by a
			working embedded engineer, with sources linked throughout.
		</p>
	</section>
	<div class="eep-home">
		<ul class="eep-cards">
			<li>
				<a href="/help/">
					<strong>Help</strong>
					<span>
						Links to job boards, pay data and other sites for your job search.
					</span>
				</a>
			</li>
			<li>
				<a href="/advice/">
					<strong>Advice</strong>
					<span>
						How to write a one-page resume, get hired, and pick projects that
						count.
					</span>
				</a>
			</li>
		</ul>
		<HomeCoverFigure />
		<div class="eep-home-main">
			<p>
				New here?{' '}
				<a href="/advice/resume/quick-setup/">The whole guide on one page</a>{' '}
				takes five minutes.
			</p>
			<p>
				Ask for a referral before you apply, whenever you can.{' '}
				<a href="/advice/getting-hired/#get-a-referral-first">
					Getting hired says how to ask
				</a>
				.
			</p>
			<p>
				The <a href="/roadmap/">roadmap</a> lists what is coming next.
			</p>
			<p class="eep-generator">
				<Fragment set:html={generatorLink} /> is a free, open-source tool that
				turns one file into a one-page PDF, so you don't have to format a resume
				by hand.
			</p>
		</div>
	</div>
</StarlightPage>
