---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: 'eeprep',
		description:
			'Free, plain advice for electrical engineering students on writing a one-page resume, finding a first internship and running a job search, plus a reference list.',
		head: [
			{
				tag: 'title',
				content: 'eeprep | Resumes and job hunting for EE students',
			},
		],
		template: 'splash',
		pagefind: false,
	}}
	hasSidebar={false}
>
	<section class="eep-hero">
		<h1>
			Plain advice on resumes and job hunting for electrical engineering
			students.
		</h1>
	</section>
	<ul class="eep-cards">
		<li>
			<a href="/reference/">
				<strong>Reference</strong>
				<span>
					Links to job boards, salary data and other outside resources for your
					job hunt.
				</span>
			</a>
		</li>
		<li>
			<a href="/advice/resume/">
				<strong>Advice</strong>
				<span>
					How to write a one-page resume and land your first internship, step by
					step.
				</span>
			</a>
		</li>
	</ul>
	<p>
		<a href="/roadmap/">Roadmap</a>
	</p>
	<p class="eep-generator">
		Want a resume without formatting it by hand?{' '}
		<a href="https://github.com/edwardasilva/resume-generator">
			resume-generator
		</a>{' '}
		is a free, open-source tool that turns one file into a one-page PDF.
	</p>
</StarlightPage>
