---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
	frontmatter={{
		title: 'EE Prep',
		description:
			'A free guide for electrical engineering students: write a resume, land a first internship, and look up job and visa links.',
		head: [
			{
				tag: 'title',
				content: 'EE Prep: resumes and internships for EE students',
			},
		],
		template: 'splash',
		pagefind: false,
	}}
	hasSidebar={false}
>
	<section class="eep-hero">
		<p class="eep-eyebrow">For EE students</p>
		<h1>Get hired. Keep a reference.</h1>
		<p class="eep-lede">
			A textbook for electrical engineering students who want a job and a place
			to look things up.
		</p>
		<p class="eep-actions">
			<a class="eep-btn" href="/get-hired/resume/">
				Start with getting hired
			</a>
		</p>
	</section>
	<ul class="eep-cards">
		<li>
			<a href="/get-hired/resume/">
				<span class="eep-eyebrow">01</span>
				<strong>Get hired</strong>
				<span>
					The resume, the applications, and the market you are walking into.
				</span>
			</a>
		</li>
		<li>
			<a href="/reference/">
				<span class="eep-eyebrow">02</span>
				<strong>Reference</strong>
				<span>
					Official and community links for pay data, openings, and student
					visas.
				</span>
			</a>
		</li>
	</ul>
	<section class="eep-start">
		<h2>Start here</h2>
		<ol>
			<li>
				<a href="/get-hired/resume/">Resume</a>
			</li>
		</ol>
	</section>
</StarlightPage>
