# Overlay on eeprep.mplstyle for dark-mode figure variants (prefer CSS themeify; use this for raster exports)
text.color        : efebe4
axes.labelcolor   : b3ada3
axes.edgecolor    : efebe4
axes.prop_cycle   : cycler(color=["efebe4", "e06a5f", "8cc0e6", "a9cf86", "8c867c"])
grid.color        : 2e2c28
xtick.color       : 8c867c
ytick.color       : 8c867c
xtick.labelcolor  : 8c867c
ytick.labelcolor  : 8c867c
patch.edgecolor   : efebe4
