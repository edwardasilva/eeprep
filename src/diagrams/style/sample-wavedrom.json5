// Reference figure: SPI mode 0 (CPOL=0, CPHA=0) byte transfer, MSB first. MOSI is the highlighted signal.
// One character = half a bit, so SCLK rises mid-bit (sample on ↑) and data shifts on ↓.
{
	signal: [
		{ name: 'CS', wave: '10....................1.' },
		{ name: 'SCLK', wave: '0....hlhlhlhlhlhlhlhl...' },
		{
			name: ['tspan', { class: 'hl' }, 'MOSI'],
			wave: 'x...=.=.=.=.=.=.=.=.x...',
			data: ['b7', 'b6', 'b5', 'b4', 'b3', 'b2', 'b1', 'b0'],
		},
		{
			name: 'MISO',
			wave: 'z...3.3.3.3.3.3.3.3.z...',
			data: ['b7', 'b6', 'b5', 'b4', 'b3', 'b2', 'b1', 'b0'],
		},
	],
	config: { hscale: 1, skin: 'eeprep' },
}
