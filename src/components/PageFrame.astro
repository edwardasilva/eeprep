---
// Splash pages (the home page) have no sidebar, so Starlight drops the phone
// menu button with it. Below 50rem, give those pages the same button and menu;
// from 50rem up they stay sidebar-free, as before.
import Default from '@astrojs/starlight/components/PageFrame.astro';
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';
import Sidebar from 'virtual:starlight/components/Sidebar';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<Default>
	<slot name="header" slot="header" />
	<slot name="sidebar" slot="sidebar" />
	<slot />
</Default>
{!hasSidebar && (
	<nav
		class="eep-splash-menu md:sl-hidden print:hidden"
		aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}
	>
		<MobileMenuToggle />
		<div popover="auto" id="starlight__sidebar" class="eep-splash-pane">
			<div class="eep-splash-content">
				<Sidebar />
			</div>
		</div>
	</nav>
)}

<style>
	.eep-splash-pane {
		position: fixed;
		inset: var(--sl-nav-height) 0 0;
		z-index: var(--sl-z-index-menu);
		width: 100%;
		height: auto;
		margin: 0;
		border: 0;
		padding: 0;
		background-color: var(--sl-color-black);
		color: inherit;
		overflow-y: auto;
		scrollbar-gutter: stable;
	}
	.eep-splash-content {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		min-height: max-content;
		padding: 1rem var(--sl-sidebar-pad-x) 0;
	}
</style>
