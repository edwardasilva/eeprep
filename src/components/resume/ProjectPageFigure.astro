---
import { externalLinks } from './caption';
// Figure 19.1 as HTML and CSS. The sections of one project page on a
// portfolio site, top to bottom, in the order a reader meets them. One box per
// section, all the same.
const sections = [
	{ title: 'Result line', body: 'What it does and the measured number.' },
	{ title: 'Photo', body: 'The board, the bench, or the scope screen.' },
	{ title: 'Design', body: 'Block diagram and the choices you made.' },
	{ title: 'Hardware', body: 'Schematic and layout as images, part list.' },
	{ title: 'Software', body: 'What the code does, with a link to the repo.' },
	{ title: 'Results', body: 'Scope captures, logs, and a table of numbers.' },
	{ title: 'What broke', body: 'The bug, how you found it, what you changed.' },
];
const alt =
	'Seven sections of a project page in order. Result line: what it does and the measured number. Photo: the board, the bench, or the scope screen. Design: block diagram and the choices you made. Hardware: schematic and layout as images, and the part list. Software: what the code does, with a link to the repo. Results: scope captures, logs, and a table of numbers. What broke: the bug, how you found it, and what you changed.';
const caption = externalLinks(
	`One page per project. The order follows the student project sites in <a href="https://people.ece.cornell.edu/land/courses/ece4760/FinalProjects/">Cornell's ECE 4760</a>, which run from the design to the results and keep the code, schematics, and part lists in appendices.`,
);
---

<figure class="eep-fig wide eep-ppage-fig" id="fig-19-1">
	<p class="eep-kicker">One project page, top to bottom</p>
	<p class="sr-only">{alt}</p>
	<div class="eep-ppage not-content" aria-hidden="true">
		<ol>
			{sections.map((s, i) => (
				<li>
					<span class="eep-ppage-num">{i + 1}</span>
					<div>
						<p class="eep-ppage-title">{s.title}</p>
						<p class="eep-ppage-body">{s.body}</p>
					</div>
				</li>
			))}
		</ol>
	</div>
	<figcaption>
		<span class="eep-fignum"></span> <span set:html={caption} />
	</figcaption>
</figure>

<style>
	.eep-ppage {
		margin-top: 1rem;
		container-type: inline-size;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
	}
	.eep-ppage p {
		margin: 0;
		max-width: none;
		overflow-wrap: anywhere;
	}
	.eep-ppage ol {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.eep-ppage li {
		display: grid;
		grid-template-columns: 1.75rem 1fr;
		gap: 0.75rem;
		align-items: start;
		margin: 0;
		max-width: none;
		padding: 0.5rem 0.75rem;
		border: var(--eep-dg-line) solid var(--eep-dg-mute);
		border-radius: 4px;
		background: var(--eep-dg-tint);
	}
	.eep-ppage-num {
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border: var(--eep-dg-line) solid var(--eep-dg-ink);
		border-radius: 50%;
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1;
	}
	.eep-ppage-title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.eep-ppage-body {
		margin-top: 0.15rem;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
	@container (min-width: 36rem) {
		.eep-ppage ol {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
