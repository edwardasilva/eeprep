---
import { externalLinks } from './caption';
// Figure 13.1 as HTML and CSS. A schematic page with its regions outlined,
// and one check per region beside it. The regions are the sections of Alex's
// finished page in Figure 4.4, plus the file itself. The sheet follows the same
// formatting: a centered header with a name, one contact line, and relocation,
// then Education, Projects, Experience, and Skills, left-aligned, with a date
// tick at the right margin and an equal gap between sections.
// Each row is a bar. w is its width as a percent of the line, bold marks a
// title or a name, and d adds a date tick at the right margin.
interface Row {
	w: number;
	d?: boolean;
	bold?: boolean;
}
const zones: { label: string; check: string; rows?: Row[] }[] = [
	{
		label: 'File',
		check:
			'Extract the text and read it in order. One page. Title and author set.',
	},
	{
		label: 'Header',
		check:
			'Every link clicked. Plain text, no icons. One contact line, then an optional location line with "Willing to relocate" if you will move.',
		rows: [{ w: 36, bold: true }, { w: 90 }, { w: 40 }],
	},
	{
		label: 'Education',
		check:
			'GPA listed at 3.50 or higher, from 3.0 to 3.49 only when the posting sets a minimum you meet, off below 3.0. One line of upper-level coursework, if you have any.',
		rows: [{ w: 62, bold: true }, { w: 40, d: true }, { w: 70 }],
	},
	{
		label: 'Projects',
		check:
			'Each bullet: a past-tense verb, a tool, and a number wherever you measured one. Explain every number.',
		rows: [
			{ w: 52, bold: true, d: true },
			{ w: 88 },
			{ w: 76 },
			{ w: 46, bold: true, d: true },
			{ w: 88 },
			{ w: 70 },
		],
	},
	{
		label: 'Experience',
		check:
			'Unrelated jobs cut to one line once you have an internship or other technical work. Engineering roles get bullets.',
		rows: [{ w: 50, bold: true, d: true }, { w: 24 }],
	},
	{
		label: 'Skills',
		check:
			'Every tool appears in a bullet. No soft skills. C and C++ as two items.',
		rows: [{ w: 66 }, { w: 80 }],
	},
];
const alt =
	"A schematic one-page resume with six regions outlined, and one check beside each. File: extract the text and read it in order, one page, title and author set. Header: every link clicked, plain text, no icons, one contact line, then an optional location line that says you are willing to relocate if you will move. Education: GPA listed at 3.50 or higher, from 3.0 to 3.49 only when the posting sets a minimum you meet, off below 3.0, one line of upper-level coursework if you have any. Projects: each bullet has a past-tense verb, a tool, and a number wherever you measured one, and you can explain every number. Experience: unrelated jobs cut to one line once you have an internship or other technical work, and engineering roles get bullets. Skills: every tool appears in a bullet, no soft skills, C and C++ as two items. The page is drawn the way Alex's finished page is formatted: a centered header with a name, one contact line, and a line for location and relocation, then Education, Projects, Experience, and Skills in that order, left-aligned, with a date at the right margin of each entry and an equal gap between sections.";
const caption = externalLinks(
	`Each region gets one check, in the order of Alex's page. Check yours in the order your page uses. Sources: the <a href="https://www.reddit.com/r/EngineeringResumes/wiki/index/">r/EngineeringResumes wiki</a>, <a href="https://capd.mit.edu/resources/make-your-resume-ats-friendly/">MIT's career office on ATS-friendly resumes</a>, and <a href="https://ecs.grainger.illinois.edu/student-resources/resumes-letters/resumes">Illinois Engineering Career Services</a>.`,
);
---

<figure class="eep-fig wide eep-audit-fig" id="fig-13-1">
	<p class="eep-kicker">The audit, top to bottom</p>
	<p class="sr-only">{alt}</p>
	<div class="eep-audit not-content" aria-hidden="true">
		<div class="eep-audit-sheet">
			{zones.slice(1).map((zone, i) => (
				<div class:list={['eep-audit-zone', { 'eep-audit-header': i === 0 }]}>
					<span class="eep-audit-num eep-num">{i + 2}</span>
					{i > 0 && <span class="eep-audit-zone-label">{zone.label}</span>}
					<span class="eep-audit-lines">
						{zone.rows?.map((row) => (
							<span class="eep-audit-row">
								<span
									class:list={['eep-audit-bar', { bold: row.bold }]}
									style={`width: ${row.w}%`}
								/>
								{row.d && <span class="eep-audit-date" />}
							</span>
						))}
					</span>
				</div>
			))}
			<span class="eep-audit-file">
				<span class="eep-audit-num eep-num">1</span>
			</span>
		</div>
		<ol class="eep-audit-checks eep-num-list">
			{zones.map((zone) => (
				<li>
					<span>
						<strong>{zone.label}.</strong> {zone.check}
					</span>
				</li>
			))}
		</ol>
	</div>
	<figcaption>
		<span class="eep-fignum"></span> <span set:html={caption} />
	</figcaption>
</figure>

<style>
	.eep-audit-fig .eep-kicker {
		line-height: 1.35;
	}
	.eep-audit {
		margin-top: 1rem;
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(14rem, 1.2fr);
		gap: 1.5rem;
		align-items: start;
		container-type: inline-size;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
	}
	.eep-audit p {
		margin: 0;
		max-width: none;
	}
	/* The page. Pin 1 sits on its top corner, because the first check is the file. */
	.eep-audit-sheet {
		position: relative;
		display: grid;
		gap: 0.55rem;
		padding: 1.1rem 0.9rem 1rem;
		border: 1px solid var(--eep-dg-mute);
		border-radius: var(--eep-radius);
		background: var(--eep-dg-fill);
	}
	.eep-audit-file {
		position: absolute;
		top: -0.65rem;
		left: -0.65rem;
	}
	.eep-audit-zone {
		position: relative;
		padding: 0.45rem 0.55rem 0.5rem 2.1rem;
		border: var(--eep-dg-dash);
		border-radius: var(--eep-radius-sm);
	}
	.eep-audit-header {
		text-align: center;
	}
	.eep-audit-num {
		position: absolute;
		top: 0.4rem;
		left: 0.45rem;
	}
	.eep-audit-file .eep-audit-num {
		position: static;
	}
	.eep-audit-zone-label {
		display: block;
		font-size: 0.75rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.eep-audit-lines {
		display: grid;
		gap: 0.2rem;
		margin-top: 0.3rem;
	}
	.eep-audit-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
	}
	.eep-audit-bar,
	.eep-audit-date {
		display: block;
		height: 0.4rem;
		border-radius: var(--eep-radius-sm);
		background: var(--eep-dg-tint);
		border: 1px solid var(--eep-dg-mute);
	}
	.eep-audit-bar {
		min-width: 0;
	}
	/* A title or a name is bold on the page, so its bar is darker. */
	.eep-audit-bar.bold {
		background: var(--eep-dg-mute);
	}
	.eep-audit-date {
		flex: none;
		width: 22%;
	}
	/* The header is centered, with one contact line and relocation. */
	.eep-audit-header .eep-audit-row {
		justify-content: center;
	}
	.eep-audit-checks {
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: audit;
	}
	.eep-audit-checks li {
		display: flex;
		gap: 0.6rem;
		align-items: flex-start;
		margin: 0 0 0.75rem;
		max-width: none;
		font-size: 0.9rem;
		line-height: 1.45;
	}
	.eep-audit-checks li > span {
		min-width: 0;
	}
	.eep-audit-checks li::before {
		counter-increment: audit;
		content: counter(audit);
	}
	@container (max-width: 34rem) {
		.eep-audit {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
