---
// Figure 12.3 as HTML and CSS. What projects do for a page and what
// experience does, side by side, with the one move between them. Two equal
// boxes, so neither is the headline. The page text says why the move happens.
const columns = [
	{
		title: 'Projects',
		role: 'Earn the first interview',
		items: [
			'What a student has before anyone pays them to engineer',
			'Proof you can build, measure, and finish',
			'The questions in the first interviews',
		],
	},
	{
		title: 'Experience',
		role: 'Takes over the page',
		items: [
			'Value added for someone who was paying for it',
			'Takes the top of the page with the first internship',
			'Pushes the oldest class project down, then off',
			'The questions in every interview after',
		],
	},
];
const alt =
	'Two columns. Projects earn the first interview: what a student has before anyone pays them to engineer, proof you can build, measure, and finish, and the questions in the first interviews. Experience takes over the page: value added for someone who was paying for it, it takes the top of the page with the first internship, it pushes the oldest class project down and then off, and it is the questions in every interview after. An arrow from Projects to Experience is labeled: the first internship.';
const arrow = 'M1 1.5L9 5L1 8.5Z';
---

<figure class="eep-fig wide eep-door-fig" id="fig-12-3">
	<p class="eep-kicker">Projects first, then paid work</p>
	<p class="sr-only">{alt}</p>
	<div class="eep-door not-content" aria-hidden="true">
		{columns.map((c, i) => (
			<>
				<div class="eep-door-col">
					<p class="eep-door-title">{c.title}</p>
					<p class="eep-door-role">{c.role}</p>
					<ul>
						{c.items.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
				{i === 0 && (
					<div class="eep-door-move">
						<span class="eep-door-line"></span>
						<svg class="eep-door-arrow" viewBox="0 0 10 10" focusable="false">
							<path d={arrow} />
						</svg>
						<p>the first internship</p>
					</div>
				)}
			</>
		))}
	</div>
	<figcaption>
		<span class="eep-fignum"></span>{' '}
		<span>
			Projects earn the first interview, and the first paid role takes over the
			page from then on.
		</span>
	</figcaption>
</figure>

<style>
	.eep-door-fig .eep-kicker {
		line-height: 1.35;
	}
	.eep-door {
		margin-top: 1rem;
		display: grid;
		gap: 0.5rem;
		container-type: inline-size;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
	}
	.eep-door p,
	.eep-door ul {
		margin: 0;
		max-width: none;
	}
	.eep-door-col {
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--eep-dg-mute);
		border-radius: var(--eep-radius);
		background: var(--eep-dg-tint);
	}
	.eep-door-title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.eep-door-role {
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
	.eep-door ul {
		display: grid;
		gap: 0.25rem;
		margin-top: 0.45rem;
		padding: 0;
		list-style: none;
	}
	.eep-door li {
		position: relative;
		margin: 0;
		max-width: none;
		padding-left: 0.9rem;
		font-size: 0.8125rem;
		line-height: 1.45;
	}
	.eep-door li::before {
		content: '';
		position: absolute;
		top: 0.5rem;
		left: 0;
		width: 0.4rem;
		height: 0.4rem;
		border: var(--eep-dg-line) solid var(--eep-dg-ink);
		border-radius: 50%;
	}
	/* The move between the columns: a line, an arrow, and its label. */
	.eep-door-move {
		display: grid;
		justify-items: center;
		gap: 0.15rem;
		padding: 0.1rem 0;
	}
	.eep-door-line {
		width: var(--eep-dg-line);
		height: 0.9rem;
		background: var(--eep-dg-ink);
	}
	.eep-door-arrow {
		width: 0.6rem;
		height: 0.6rem;
		margin-top: -0.3rem;
		fill: var(--eep-dg-ink);
		transform: rotate(90deg);
	}
	.eep-door-move p {
		font-size: 0.8125rem;
		line-height: 1.4;
		color: var(--eep-ink-2);
	}
	@container (min-width: 40rem) {
		.eep-door {
			grid-template-columns: minmax(0, 1fr) 7rem minmax(0, 1fr);
			align-items: start;
		}
		.eep-door-move {
			align-self: center;
			grid-template-columns: 1fr auto;
			grid-template-rows: auto auto;
			column-gap: 0;
			align-items: center;
		}
		.eep-door-line {
			grid-column: 1;
			grid-row: 1;
			width: 100%;
			height: var(--eep-dg-line);
		}
		.eep-door-arrow {
			grid-column: 2;
			grid-row: 1;
			margin-top: 0;
			margin-left: -0.15rem;
			transform: none;
		}
		.eep-door-move p {
			grid-column: 1 / -1;
			grid-row: 2;
			text-align: center;
		}
	}
</style>
