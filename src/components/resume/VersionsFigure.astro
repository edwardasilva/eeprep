---
// Figure 4.7 as HTML and CSS. One inventory of facts on the left feeds five
// resume versions on the right. The facts never change between versions; the
// order, the depth, and the wording of the skills lines do. Same box for
// every version, so none is the headline.
const facts = [
	'Every project, with its measured numbers',
	'Every job, engineering or not',
	'Courses, tools, and instruments',
];
const versions = [
	{ name: 'Embedded firmware', leads: 'firmware projects lead' },
	{ name: 'Hardware and power', leads: 'board and converter work leads' },
	{ name: 'Test and validation', leads: 'bench scripts and measurements lead' },
	{ name: 'Signals and controls', leads: 'DSP and controls projects lead' },
	{ name: 'General', leads: 'for fairs and referrals, no role named' },
];
const changes = [
	'Which project leads',
	'Which bullets get a second line',
	'The coursework line',
	'The wording on the Skills lines',
];
const alt =
	'One inventory of facts feeds five resume versions. The inventory holds every project with its measured numbers, every job, and the courses, tools, and instruments. The first version is embedded firmware, where firmware projects lead. The second is hardware and power, where board and converter work leads. The third is test and validation, where bench scripts and measurements lead. The fourth is signals and controls, where DSP and controls projects lead. The fifth is a general version for fairs and referrals with no role named. What changes between versions: which project leads, which bullets get a second line, the coursework line, and the wording on the Skills lines. The facts stay the same on every version.';
---

<figure class="eep-fig wide eep-ver-fig" id="fig-versions">
	<p class="eep-kicker">One set of facts, five versions</p>
	<p class="sr-only">{alt}</p>
	<div class="eep-ver not-content" aria-hidden="true">
		<div class="eep-ver-facts">
			<p class="eep-ver-head">The inventory</p>
			<ul>
				{facts.map((f) => (
					<li>{f}</li>
				))}
			</ul>
		</div>
		<div class="eep-ver-join"></div>
		<ol class="eep-ver-list">
			{versions.map((v) => (
				<li>
					<p class="eep-ver-name">{v.name}</p>
					<p class="eep-ver-leads">{v.leads}</p>
				</li>
			))}
		</ol>
		<div class="eep-ver-changes">
			<p class="eep-ver-head">What changes between versions</p>
			<ul>
				{changes.map((c) => (
					<li>{c}</li>
				))}
			</ul>
			<p class="eep-ver-note">The facts do not.</p>
		</div>
	</div>
	<figcaption>
		<span class="eep-fignum"></span>{' '}
		<span>
			Keep 4 or 5 versions aimed at the roles you want, and send the closest
			one. Tailor by hand only for the posting that matters most.
		</span>
	</figcaption>
</figure>

<style>
	.eep-ver-fig .eep-kicker {
		line-height: 1.35;
	}
	.eep-ver {
		margin-top: 1rem;
		--line: 1.5px;
		display: grid;
		gap: 0.75rem;
		container-type: inline-size;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
	}
	.eep-ver p,
	.eep-ver ul,
	.eep-ver ol {
		margin: 0;
		max-width: none;
	}
	.eep-ver ul,
	.eep-ver ol {
		padding: 0;
		list-style: none;
	}
	.eep-ver-facts,
	.eep-ver-changes,
	.eep-ver-list li {
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--eep-dg-mute);
		border-radius: 4px;
		background: var(--eep-dg-tint);
	}
	.eep-ver-facts ul,
	.eep-ver-changes ul {
		display: grid;
		gap: 0.25rem;
		margin-top: 0.35rem;
	}
	.eep-ver-facts li,
	.eep-ver-changes li {
		position: relative;
		padding-left: 0.9rem;
		font-size: 0.8125rem;
		line-height: 1.45;
	}
	.eep-ver-facts li::before,
	.eep-ver-changes li::before {
		content: '';
		position: absolute;
		top: 0.5rem;
		left: 0;
		width: 0.4rem;
		height: 0.4rem;
		border: var(--line) solid var(--eep-dg-ink);
		border-radius: 50%;
	}
	.eep-ver-head {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.eep-ver-note {
		margin-top: 0.35rem;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
	/* The join is the line from the inventory to the versions. It spans the grid gap on both
	   sides, so it touches both boxes. */
	.eep-ver-join {
		height: 2.25rem;
		width: var(--line);
		margin: -0.75rem auto;
		background: var(--eep-dg-ink);
	}
	.eep-ver-list {
		display: grid;
		gap: 0.5rem;
	}
	.eep-ver-list li {
		margin: 0;
	}
	.eep-ver-name {
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.eep-ver-leads {
		margin-top: 0.15rem;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
	@container (min-width: 36rem) {
		.eep-ver {
			grid-template-columns: minmax(0, 11rem) 2rem minmax(0, 1fr);
			grid-template-rows: auto auto;
			column-gap: 0;
			align-items: start;
		}
		.eep-ver-facts {
			grid-column: 1;
			grid-row: 1;
			align-self: center;
		}
		.eep-ver-join {
			grid-column: 2;
			grid-row: 1;
			align-self: center;
			width: 100%;
			height: var(--line);
			margin: 0;
		}
		.eep-ver-list {
			grid-column: 3;
			grid-row: 1;
		}
		.eep-ver-changes {
			grid-column: 1 / -1;
			grid-row: 2;
		}
	}
</style>
