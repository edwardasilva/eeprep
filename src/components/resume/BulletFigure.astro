---
import ThemeSvg from './ThemeSvg.astro';
import light from '../../diagrams/resume/bullet.svg?url';
import dark from '../../diagrams/resume/bullet-dark.svg?url';
import path from 'node:path';

const dir = path.resolve('src/diagrams/resume');

const alt =
	"Did X with Y to get Z. Before: Worked on a buck converter for a CubeSat using LTspice and KiCad. Worked on hides what Alex did. There's no spec, no check, and no result. After: Designed a [X] W synchronous buck converter in KiCad for a CubeSat power board and measured [X]% efficiency on an electronic load, within [X]% of the LTspice model. X is the action and one spec, Y is the tool, and Z is the measured result. Screeners filter on X and Y. Hiring managers choose from the Zs. Every [X] is a number you measure yourself.";
---

<figure class="eep-fig wide eep-theme-fig" id="fig-2">
	<ThemeSvg
		light={light}
		dark={dark}
		lightFile={path.join(dir, 'bullet.svg')}
		darkFile={path.join(dir, 'bullet-dark.svg')}
		alt={alt}
	/>
	<figcaption>
		<span class="eep-fignum">Fig 2</span>
		<span>
			Alex Doe is a made-up student. Pattern from the r/EngineeringResumes wiki
			(XYZ, STAR, and CAR methods) and a reviewer's readability guide.
		</span>
	</figcaption>
</figure>
