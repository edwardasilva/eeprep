---
import Default from '@astrojs/starlight/components/Footer.astro';
import Backlinks from './Backlinks.astro';

import { externalLinks } from './resume/caption';

// Plain-text license and source notice under every page. The links get the same
// external-link markup as links in the guide text.
const splash = Astro.locals.starlightRoute.entry.data.template === 'splash';
const notice = externalLinks(
	`Content by <a href="https://github.com/edwardasilva/eeprep">eeprep contributors</a>, licensed <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. Code licensed <a href="https://opensource.org/license/mit">MIT</a>. Source is in the <a href="https://github.com/edwardasilva/eeprep">eeprep</a>, <a href="https://github.com/edwardasilva/resume-generator">resume-generator</a>, and <a href="https://github.com/edwardasilva/company-lists">company-lists</a> repositories.`,
);
---

{splash ? null : <Backlinks class="eep-backlinks-end lg:sl-hidden" />}
<Default />
<p class="eep-license" set:html={notice} />

<style>
	.eep-license {
		margin-top: 2rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.eep-license :global(a) {
		color: inherit;
	}
</style>
