---
import Default from '@astrojs/starlight/components/Footer.astro';

import { externalLinks } from './resume/caption';

// Plain-text license notice under every page. The links get the same
// external-link markup as links in the guide text.
const notice = externalLinks(
	`Content licensed <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. Code licensed <a href="https://opensource.org/license/mit">MIT</a>.`,
);
---

<Default />
<p class="eep-license" set:html={notice} />

<style>
	.eep-license {
		margin-top: 2rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.eep-license :global(a) {
		color: inherit;
	}
</style>
