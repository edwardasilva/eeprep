---
import Default from '@astrojs/starlight/components/Footer.astro';
import Backlinks from './Backlinks.astro';

import { externalLinks } from './resume/caption';
import { siteUpdated, siteUpdatedText } from '../lib/site-updated';
import { contentLicense } from '../lib/site';

// Plain-text license and source notice under every page, after the one
// "Last updated" date for the whole site. The links get the same external-link
// markup as links in the guide text.
const splash = Astro.locals.starlightRoute.entry.data.template === 'splash';
const notice = externalLinks(
	`Content by <a href="https://github.com/edwardasilva/eeprep">eeprep contributors</a>, licensed <a href="${contentLicense}">CC BY 4.0</a>. Code licensed <a href="https://opensource.org/license/mit">MIT</a>. Source is in the <a href="https://github.com/edwardasilva/eeprep">eeprep</a>, <a href="https://github.com/edwardasilva/resume-generator">resume-generator</a>, and <a href="https://github.com/edwardasilva/company-lists">company-lists</a> repositories.`,
);
---

{splash ? null : <Backlinks class="eep-backlinks-end lg:sl-hidden" />}
<Default />
<p class="eep-license">
	Last updated{' '}
	<time datetime={siteUpdated.toISOString()}>{siteUpdatedText}</time>.{' '}
	<Fragment set:html={notice} />
</p>

<style>
	.eep-license {
		margin-top: 2rem;
		font-size: var(--eep-text-caption);
		line-height: var(--eep-lh-ui);
		color: var(--eep-ink-2);
	}
	.eep-license :global(a) {
		color: inherit;
	}
	/* Keep each link on one line, so "CC BY 4.0" and "resume-generator" never
	   break across two lines on a phone. In body text, link words may wrap. */
	.eep-license :global(a.external-link > .eep-ext-text) {
		white-space: nowrap;
	}
</style>
