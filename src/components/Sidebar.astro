---
// Starlight's sidebar, with parent-page groups (see src/lib/sidebar-parents.mjs).
// No mobile menu footer: its only control was a second theme toggle, and the
// header already has one at every width.
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarTree from './sidebar/SidebarTree.astro';

const { sidebar } = Astro.locals.starlightRoute;
---

<SidebarPersister>
	<SidebarTree sublist={sidebar} />
</SidebarPersister>
