---
// Figure 25.1 as HTML and CSS. How a change reaches eeprep.com, from the
// issue to the release, as one row of steps. Every step gets the same box.
// The dashed box is the dev site, which a merge reaches before a release
// does, and the page text explains it.
const steps = [
	{
		title: 'Issue',
		body: 'Every change starts as one. Name the page and the fix.',
	},
	{
		title: 'Branch and pull request',
		body: 'A short branch from main. 50 to 300 lines, with proof.',
	},
	{
		title: 'Checks',
		body: 'Links, citations, figure rules, Vale, lint, and the build.',
	},
	{ title: 'Squash merge', body: 'One commit on main. The branch is deleted.' },
	{
		title: 'Release tag',
		body: 'A version tag publishes the merged work to eeprep.com.',
	},
];
const alt =
	'Five steps in order. Issue: every change starts as one, naming the page and the fix. Branch and pull request: a short branch from main, 50 to 300 lines, with proof. Checks: links, citations, figure rules, Vale, lint, and the build. Squash merge: one commit on main, and the branch is deleted. Release tag: a version tag publishes the merged work to eeprep.com. A dashed note under the squash merge says that a merge deploys the dev site, which search engines skip.';
const arrow = 'M1 1.5L9 5L1 8.5Z';
---

<figure class="eep-fig wide eep-flow-fig" id="fig-25-1">
	<p class="eep-kicker">How a change reaches the site</p>
	<p class="sr-only">{alt}</p>
	<div class="eep-flow not-content" aria-hidden="true">
		<ol>
			{steps.map((s, i) => (
				<li>
					<p class="eep-flow-title">{s.title}</p>
					<p class="eep-flow-body">{s.body}</p>
					{i !== steps.length - 1 && (
						<svg class="eep-flow-arrow" viewBox="0 0 10 10" focusable="false">
							<path d={arrow} />
						</svg>
					)}
				</li>
			))}
		</ol>
		<p class="eep-flow-dev">
			A merge to main deploys the dev site first, which search engines skip. The
			tag is what reaches eeprep.com.
		</p>
	</div>
	<figcaption>
		<span class="eep-fignum"></span>{' '}
		<span>
			The path from an idea to the live site. The contribution guide on GitHub
			lists the commands behind each step.
		</span>
	</figcaption>
</figure>

<style>
	.eep-flow-fig .eep-kicker {
		line-height: 1.35;
	}
	.eep-flow {
		margin-top: 1rem;
		container-type: inline-size;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
	}
	.eep-flow p {
		margin: 0;
		max-width: none;
	}
	.eep-flow ol {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.eep-flow li {
		position: relative;
		margin: 0;
		max-width: none;
		padding: 0.6rem 0.75rem;
		border: var(--eep-dg-line) solid var(--eep-dg-mute);
		border-radius: 4px;
		background: var(--eep-dg-tint);
	}
	.eep-flow-title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.eep-flow-body {
		margin-top: 0.2rem;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
	.eep-flow-arrow {
		position: absolute;
		left: 50%;
		bottom: -0.7rem;
		width: 0.6rem;
		height: 0.6rem;
		fill: var(--eep-dg-ink);
		transform: translateX(-50%) rotate(90deg);
	}
	/* The dev site is a side effect of the merge, so it is the one dashed box. */
	.eep-flow-dev {
		margin-top: 0.75rem;
		padding: 0.5rem 0.75rem;
		border: var(--eep-dg-dash);
		border-radius: 4px;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
	@container (min-width: 44rem) {
		.eep-flow ol {
			grid-template-columns: repeat(5, minmax(0, 1fr));
			gap: 0 0.75rem;
		}
		.eep-flow-arrow {
			left: auto;
			right: -0.7rem;
			bottom: auto;
			top: 0.85rem;
			transform: none;
		}
	}
</style>
