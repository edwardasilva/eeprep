---
import { externalLinks } from '../resume/caption';
// Figure 5.1 as HTML and CSS. Five bands across senior year. On wide figures
// they run left to right in one row, with the two deadline markers in a row
// underneath. On narrow ones they hang off one line down the left side, each
// marker under its band. The peaks sit on a tinted box. April has no band, so
// the line runs straight from March to May.
const bands = [
	{
		date: 'Jul to Aug',
		title: 'Get ready',
		body: 'Update the resume, list target companies, and tell past supervisors.',
		mark: 'Return offer deadline at some schools: Sep 15 or 3 weeks, whichever is later',
	},
	{
		date: 'Sep to Nov',
		title: 'Peak 1',
		body: 'Most full-time applications open in September and October. New-grad programs fill first.',
		peak: true,
		focus: true,
		mark: 'Fall offer deadline at some schools: Nov 1 or 3 weeks, whichever is later',
	},
	{
		date: 'Dec',
		title: 'Holiday slowdown',
		body: 'Postings reopen in January.',
	},
	{
		date: 'Jan to Mar',
		title: 'Peak 2',
		body: 'A second wave opens after budgets reset.',
		peak: true,
	},
	{
		date: 'May to Aug',
		title: 'Summer hiring',
		body: 'Smaller companies hire for immediate needs.',
	},
];
const alt =
	'Timeline of senior-year recruiting. July to August, get ready. September to November, the first peak, when most full-time applications open. December, a holiday slowdown. January to March, a second peak. May to August, summer hiring at smaller companies. Markers show a September 15 return offer deadline and a November 1 fall offer deadline at some schools.';
const caption = externalLinks(
	`Full-time engineering recruiting has two peaks. Apply early in each one. Sources: <a href="https://careerdevelopment.princeton.edu/internships-jobs/recruiting-timelines">Princeton's recruiting timelines</a>, <a href="https://ocs.yale.edu/industry-hiring-timelines/">Yale's hiring timelines</a>, <a href="https://www.lebow.drexel.edu/careers-recruiting/center-career-readiness/advising/job-search-timeline">Drexel's senior-year timeline</a>, <a href="https://www.eng.ufl.edu/undergraduate/programs-and-partnerships/center-for-experiential-learning/general-career-services/">University of Florida offer deadlines</a>, and <a href="https://ecs.osu.edu/employers/recruiting-guidelines-policies/hiring-students">Ohio State offer deadlines</a>.`,
);
const arrow = 'M1 1.5L9 5L1 8.5Z';
---

<figure class="eep-fig wide eep-recruit-fig" id="fig-5-1">
	<p class="eep-kicker">Figure 5.1 · New-grad recruiting in senior year</p>
	<p class="sr-only">{alt}</p>
	<div class="eep-recruit not-content" aria-hidden="true">
		<ol>
			{bands.map((b) => (
				<li
					class:list={[
						'eep-recruit-band',
						{
							'eep-recruit-peak': b.peak,
							'eep-recruit-focus': b.focus,
							'eep-recruit-hasmark': b.mark,
						},
					]}
				>
					<p class="eep-recruit-date">{b.date}</p>
					<span class="eep-recruit-node" />
					<svg class="eep-recruit-arrow" viewBox="0 0 10 10" focusable="false">
						<path d={arrow} />
					</svg>
					<div class="eep-recruit-text">
						<p class="eep-recruit-title">{b.title}</p>
						<p class="eep-recruit-body">{b.body}</p>
					</div>
					{b.mark ? (
						<p class="eep-recruit-mark">{b.mark}</p>
					) : (
						<span class="eep-recruit-nomark" />
					)}
				</li>
			))}
		</ol>
	</div>
	<figcaption>
		<span class="eep-fignum">Fig 5.1</span> <span set:html={caption} />
	</figcaption>
</figure>

<style>
	.eep-recruit-fig .eep-kicker {
		line-height: 1.35;
	}
	.eep-recruit {
		margin-top: 1rem;
		--line: 1.5px;
		--node: 0.8rem;
		--indent: 1.6rem;
		--gap: 1rem;
		--tint: color-mix(in srgb, var(--eep-dg-ink) 6%, var(--eep-dg-fill));
		container-type: inline-size;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
	}
	.eep-recruit p {
		margin: 0;
		max-width: none;
		overflow-wrap: anywhere;
	}
	.eep-recruit ol {
		display: grid;
		gap: var(--gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.eep-recruit li {
		position: relative;
		margin: 0;
		max-width: none;
	}
	.eep-recruit .eep-recruit-date {
		font: 0.75rem/1.4 var(--eep-font-mono);
		color: var(--eep-ink-2);
	}
	.eep-recruit .eep-recruit-title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
		text-wrap: balance;
	}
	.eep-recruit .eep-recruit-body {
		margin-top: 0.2rem;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
	/* The peaks: a light tint with a silver edge, so they read as peaks
	   without a second color. */
	.eep-recruit-peak .eep-recruit-text {
		padding: 0.5rem 0.6rem 0.55rem;
		border: 1px solid var(--eep-dg-mute);
		border-radius: 4px;
		background: var(--tint);
	}
	/* Crimson marks the first peak only, where most applications open. */
	.eep-recruit-focus .eep-recruit-text {
		box-shadow: inset 3px 0 0 var(--eep-dg-accent);
	}
	/* Deadline markers: dashed boxes tied to the timeline by a short tick. */
	.eep-recruit .eep-recruit-mark {
		position: relative;
		margin-top: 0.75rem;
		padding: 0.5rem 0.6rem 0.55rem;
		border: var(--line) dashed var(--eep-dg-ink);
		border-radius: 4px;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}

	/* Nodes: an open ring for each band, and a crimson target on the first
	   peak like the in-person day on How to interview. */
	.eep-recruit-node {
		position: absolute;
		z-index: 1;
		top: 0.1rem;
		left: 0;
		box-sizing: border-box;
		width: var(--node);
		height: var(--node);
		border: var(--line) solid var(--eep-dg-ink);
		border-radius: 50%;
		background: var(--eep-dg-fill);
	}
	.eep-recruit-focus .eep-recruit-node {
		top: -0.025rem;
		left: -0.125rem;
		width: 1.05rem;
		height: 1.05rem;
		border: 2px solid var(--eep-dg-accent);
		background: radial-gradient(
			circle,
			var(--eep-dg-accent) 0 0.2rem,
			var(--eep-dg-fill) 0.22rem
		);
	}
	.eep-recruit-arrow {
		display: none;
	}

	/* Narrow: one line down the left side, drawn a segment at a time from
	   each node to the next, so it ends at the last node. */
	.eep-recruit-band {
		padding-left: var(--indent);
	}
	.eep-recruit-band:not(:last-child)::after {
		content: '';
		position: absolute;
		top: calc(0.1rem + var(--node) / 2);
		left: calc(var(--node) / 2 - var(--line) / 2);
		height: calc(100% + var(--gap));
		border-left: var(--line) solid var(--eep-dg-ink);
	}
	.eep-recruit .eep-recruit-text {
		margin-top: 0.3rem;
	}
	/* Each marker hangs off the line on a short tick. */
	.eep-recruit-mark::before {
		content: '';
		position: absolute;
		top: 1rem;
		left: calc(var(--node) / 2 - var(--line) / 2 - var(--indent) - var(--line));
		width: calc(var(--indent) - var(--node) / 2 + var(--line) / 2);
		border-top: var(--line) solid var(--eep-dg-ink);
	}
	.eep-recruit-nomark {
		display: none;
	}

	/* Wide: five columns in one row, the markers in a row underneath. */
	@container (min-width: 36rem) {
		.eep-recruit {
			--gap: 0.75rem;
		}
		.eep-recruit ol {
			grid-template-columns: repeat(5, minmax(0, 1fr));
			grid-template-rows: auto auto auto auto;
			gap: 0 var(--gap);
		}
		.eep-recruit-band {
			display: grid;
			grid-row: span 4;
			grid-template-rows: subgrid;
			padding: 0;
		}
		.eep-recruit-node {
			position: relative;
			top: 0;
			left: 0;
			margin: 0.35rem 0 0.5rem;
		}
		.eep-recruit-focus .eep-recruit-node {
			top: -0.125rem;
			left: -0.125rem;
			margin-bottom: calc(0.5rem - 0.25rem);
		}
		/* The line and its arrowhead run to the next node. */
		.eep-recruit-band:not(:last-child)::after {
			display: block;
			top: calc(1.05rem + 0.35rem + var(--node) / 2 - var(--line) / 2);
			left: var(--node);
			right: -0.4rem;
			height: var(--line);
			border-left: 0;
			background: var(--eep-dg-ink);
		}
		.eep-recruit-band:not(:last-child) .eep-recruit-arrow {
			display: block;
			position: absolute;
			top: calc(1.05rem + 0.35rem + var(--node) / 2 - 0.3rem);
			right: -0.75rem;
			width: 0.6rem;
			height: 0.6rem;
			fill: var(--eep-dg-ink);
		}
		.eep-recruit .eep-recruit-text {
			margin-top: 0;
		}
		.eep-recruit-band:not(.eep-recruit-peak) .eep-recruit-text {
			padding: 0.5rem 0 0.55rem;
		}
		/* Under bands 1 and 2, a tick runs from the band down into its
		   marker. It is cut off at the bottom of the column, and the marker's
		   own fill hides it inside the box. */
		.eep-recruit-band:not(.eep-recruit-peak) .eep-recruit-text {
			align-self: start;
		}
		.eep-recruit-hasmark {
			clip-path: inset(-1rem -2rem 0 -2rem);
		}
		.eep-recruit-hasmark .eep-recruit-text {
			position: relative;
		}
		.eep-recruit-hasmark .eep-recruit-text::after {
			content: '';
			position: absolute;
			top: 100%;
			left: calc(var(--node) / 2 - var(--line) / 2);
			height: 40rem;
			border-left: var(--line) solid var(--eep-dg-ink);
		}
		.eep-recruit-peak .eep-recruit-text::after {
			left: calc(var(--node) / 2 - var(--line) / 2 - 1px);
		}
		.eep-recruit .eep-recruit-mark {
			z-index: 1;
			background: var(--eep-dg-fill);
		}
		.eep-recruit-mark::before {
			display: none;
		}
		.eep-recruit-nomark {
			display: block;
		}
	}
</style>
