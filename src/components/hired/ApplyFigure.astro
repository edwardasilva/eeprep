---
import { externalLinks } from '../resume/caption';
// Figure 6.1 as HTML and CSS. One column of four steps. Each step has a
// short action and a short test. The last step loops back to the first, so
// the figure reads as a cycle you repeat after every batch of applications.
const steps = [
	{
		title: 'Ask for a referral',
		body: 'Alumni, professors, classmates, past coworkers. Apply the way your referrer says.',
	},
	{
		title: 'Apply within two weeks',
		body: 'Send the application soon after the posting goes up.',
	},
	{
		title: 'Count to 20',
		body: 'Track every application and every interview call.',
	},
	{
		title: 'Zero interviews from 20?',
		body: 'Change the resume or the channel before you send 20 more. Talk to a professor or meet recruiters at a career fair.',
		focus: true,
	},
];
const alt =
	'Four steps, repeated after each batch. One, ask for a referral. Two, apply within two weeks of the posting. Three, count to 20 applications. Four, if 20 applications bring zero interviews, change the resume or the channel before sending 20 more, then return to step one.';
const caption = externalLinks(
	`Apply in batches of 20 and check the result after each batch. Sources: <a href="https://www.ashbyhq.com/talent-trends-report/reports/referrals">Ashby's referral report</a>, <a href="https://careerdevelopment.princeton.edu/internships-jobs/recruiting-timelines">Princeton's recruiting timelines</a>, and <a href="https://www.reddit.com/r/ElectricalEngineering/comments/1v36dj4/best_ways_to_get_an_internship_as_2nd_year_ee/">a thread on talking to professors</a>.`,
);
---

<figure class="eep-fig wide eep-apply-fig" id="fig-6-1">
	<p class="eep-kicker">The application loop</p>
	<p class="sr-only">{alt}</p>
	<div class="eep-apply not-content" aria-hidden="true">
		<ol>
			{steps.map((s, i) => (
				<li class:list={['eep-apply-step', { 'eep-apply-focus': s.focus }]}>
					<span class="eep-apply-num">{i + 1}</span>
					<div>
						<p class="eep-apply-title">{s.title}</p>
						<p class="eep-apply-body">{s.body}</p>
					</div>
				</li>
			))}
		</ol>
		<p class="eep-apply-loop">Then return to step 1.</p>
	</div>
	<figcaption>
		<span class="eep-fignum">Fig 6.1</span> <span set:html={caption} />
	</figcaption>
</figure>

<style>
	.eep-apply {
		margin-top: 1rem;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
		--tint: color-mix(in srgb, var(--eep-dg-ink) 6%, var(--eep-dg-fill));
	}
	.eep-apply p {
		margin: 0;
		max-width: none;
		overflow-wrap: anywhere;
	}
	.eep-apply ol {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.eep-apply li {
		display: grid;
		grid-template-columns: 1.75rem 1fr;
		gap: 0.75rem;
		align-items: start;
		margin: 0;
		max-width: none;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--eep-dg-mute);
		border-radius: 4px;
		background: var(--tint);
	}
	.eep-apply-num {
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border: 1.5px solid var(--eep-dg-ink);
		border-radius: 50%;
		font: 600 0.8125rem/1 var(--eep-font-sans);
	}
	.eep-apply .eep-apply-title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.eep-apply .eep-apply-body {
		margin-top: 0.2rem;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
	/* Crimson marks the decision step only. */
	.eep-apply-focus {
		border-color: var(--eep-dg-accent);
		box-shadow: inset 3px 0 0 var(--eep-dg-accent);
	}
	.eep-apply .eep-apply-loop {
		margin-top: 0.6rem;
		font: 0.75rem/1.4 var(--eep-font-serif);
		color: var(--eep-ink-2);
		text-align: right;
	}
</style>
