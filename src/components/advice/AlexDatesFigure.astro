---
// Figure 8.2 as HTML and CSS. Alex's lines in date order, down one line on the
// left. Wide figures put the date beside the title. Narrow ones stack them.
// The dashed box is the retail line, which comes off the resume once a build
// replaces it. Crimson marks the graduation line only.
const rows = [
	{
		date: 'Summer 2023 – Summer 2024',
		title: 'Sales Associate, Retail store',
		dashed: true,
	},
	{ date: 'Fall 2024', title: 'Bluetooth Battery Monitor' },
	{
		date: 'Fall 2024 – Spring 2026',
		title: 'Power Subsystem Engineer, [Student satellite team]',
	},
	{ date: 'Spring 2025', title: 'FPGA [N]-Band Audio Equalizer' },
	{
		date: 'Summer 2025',
		title: 'Undergraduate Research Assistant, [University lab]',
	},
	{
		date: 'Fall 2025 – Spring 2026',
		title: 'Synchronous Buck Converter for a CubeSat Power Board',
	},
	{
		date: 'Expected Spring 2027',
		title: 'B.S. Electrical Engineering',
		focus: true,
	},
];
---

<figure class="eep-fig wide eep-alex-fig" id="fig-8-2">
	<p class="eep-kicker">Alex's dates</p>
	<ol class="eep-alex not-content">
		{rows.map((r) => (
			<li
				class:list={{
					'eep-alex-dashed': r.dashed,
					'eep-alex-focus': r.focus,
				}}
			>
				<p class="eep-alex-date">{r.date}</p>
				<p class="eep-alex-title">{r.title}</p>
			</li>
		))}
	</ol>
	<figcaption>
		<span class="eep-fignum">Fig 8.2</span> Alex's dates run from the retail job
		to Expected Spring 2027. The two Fall 2024 lines fall in the same term. The
		dashed retail line comes off the resume once a build replaces it.
	</figcaption>
</figure>

<style>
	.eep-alex {
		display: grid;
		gap: 0.5rem;
		margin: 1rem 0 0;
		padding: 0 0 0 1rem;
		border-left: 1.5px solid var(--eep-dg-ink);
		list-style: none;
		container-type: inline-size;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
	}
	.eep-alex li {
		display: grid;
		grid-template-columns: 11.5rem 1fr;
		gap: 0.75rem;
		align-items: baseline;
		margin: 0;
		max-width: none;
		padding: 0.5rem 0.65rem;
		border: 1px solid var(--eep-dg-mute);
		border-radius: 4px;
		background: color-mix(in srgb, var(--eep-dg-ink) 6%, var(--eep-dg-fill));
	}
	.eep-alex p {
		margin: 0;
		max-width: none;
		overflow-wrap: anywhere;
	}
	.eep-alex .eep-alex-date {
		font: 0.75rem/1.4 var(--eep-font-serif);
		color: var(--eep-ink-2);
	}
	.eep-alex .eep-alex-title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.eep-alex li.eep-alex-dashed {
		border-style: dashed;
		background: none;
	}
	.eep-alex li.eep-alex-focus {
		box-shadow: inset 3px 0 0 var(--eep-dg-accent);
	}
	@container (max-width: 28rem) {
		.eep-alex li {
			grid-template-columns: 1fr;
			gap: 0.15rem;
		}
	}
</style>
