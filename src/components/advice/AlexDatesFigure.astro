---
// Figure 8.2 as HTML and CSS. Alex's lines in date order, with a dot for each
// one on a line down the left. Wide figures put the date beside the title.
// Narrow ones stack them.
// The dashed box is the retail line, which comes off the resume once a build
// replaces it.
const rows = [
	{
		date: 'Summer 2023 – Summer 2024',
		title: 'Sales Associate, Retail store',
		dashed: true,
	},
	{ date: 'Fall 2024', title: 'Bluetooth Battery Monitor' },
	{
		date: 'Fall 2024 – Spring 2026',
		title: 'Power Subsystem Engineer, [Student satellite team]',
	},
	{ date: 'Spring 2025', title: 'FPGA [N]-Band Audio Equalizer' },
	{
		date: 'Summer 2025',
		title: 'Undergraduate Research Assistant, [University lab]',
	},
	{
		date: 'Fall 2025 – Spring 2026',
		title: 'Synchronous Buck Converter for a CubeSat Power Board',
	},
	{
		date: 'Expected Spring 2027',
		title: 'B.S. Electrical Engineering',
	},
];
---

<figure class="eep-fig wide eep-alex-fig" id="fig-8-2">
	<p class="eep-kicker">Alex's dates</p>
	<ol class="eep-alex not-content">
		{rows.map((r) => (
			<li
				class:list={{
					'eep-alex-dashed': r.dashed,
				}}
			>
				<p class="eep-alex-date">{r.date}</p>
				<p class="eep-alex-title">{r.title}</p>
			</li>
		))}
	</ol>
	<figcaption>
		<span class="eep-fignum">Fig 8.2</span> Alex's dates run from the retail job
		to Expected Spring 2027. The two Fall 2024 lines fall in the same term. The
		dashed retail line comes off the resume once a build replaces it.
	</figcaption>
</figure>

<style>
	.eep-alex {
		display: grid;
		gap: 0.5rem;
		margin: 1rem 0 0;
		padding: 0;
		--line: 1.5px;
		--node: 0.8rem;
		--rail: 1.6rem;
		list-style: none;
		container-type: inline-size;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
	}
	.eep-alex li {
		display: grid;
		grid-template-columns: 11.5rem 1fr;
		gap: 0.75rem;
		position: relative;
		align-items: baseline;
		margin: 0 0 0 var(--rail);
		max-width: none;
		padding: 0.5rem 0.65rem;
		border: 1px solid var(--eep-dg-mute);
		border-radius: 4px;
		background: color-mix(in srgb, var(--eep-dg-ink) 6%, var(--eep-dg-fill));
	}
	.eep-alex li::before {
		content: '';
		position: absolute;
		z-index: 1;
		top: 0.65rem;
		left: calc(-1 * var(--rail) - 1px);
		box-sizing: border-box;
		width: var(--node);
		height: var(--node);
		border: var(--line) solid var(--eep-dg-ink);
		border-radius: 50%;
		background: var(--eep-dg-fill);
	}
	/* One segment from each dot to the next, so the line ends at the last dot. */
	.eep-alex li:not(:last-child)::after {
		content: '';
		position: absolute;
		top: calc(0.65rem + var(--node) / 2);
		left: calc(-1 * var(--rail) - 1px + var(--node) / 2 - var(--line) / 2);
		height: calc(100% + 2px + 0.5rem);
		border-left: var(--line) solid var(--eep-dg-ink);
	}
	.eep-alex p {
		margin: 0;
		max-width: none;
		overflow-wrap: anywhere;
	}
	.eep-alex .eep-alex-date {
		font: 0.75rem/1.4 var(--eep-font-serif);
		color: var(--eep-ink-2);
	}
	.eep-alex .eep-alex-title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.eep-alex li.eep-alex-dashed {
		border-style: dashed;
		background: none;
	}
	@container (max-width: 28rem) {
		.eep-alex li {
			grid-template-columns: 1fr;
			gap: 0.15rem;
		}
	}
</style>
