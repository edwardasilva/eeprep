---
// Figure 20.1 as HTML and CSS. Which society fits which goal, in three
// columns. Every column gets the same box, and the page text says what each
// one costs and gives.
const groups = [
	{
		goal: 'A credential on the resume',
		societies: ['IEEE-HKN', 'Tau Beta Pi'],
		note: 'By invitation, from grades. One fee, for life.',
	},
	{
		goal: 'A career fair with hundreds of employers',
		societies: ['SWE', 'NSBE', 'SHPE'],
		note: 'Yearly conventions. Student dues of $10 to $20.',
	},
	{
		goal: 'Papers, standards, and conferences',
		societies: ['IEEE', 'SPIE', 'Optica', 'ACM'],
		note: 'Member rates at conferences. A student branch on campus.',
	},
];
const alt =
	'Three groups. For a credential on the resume: IEEE-HKN and Tau Beta Pi, by invitation from grades, with one fee for life. For a career fair with hundreds of employers: SWE, NSBE, and SHPE, with yearly conventions and student dues of 10 to 20 dollars. For papers, standards, and conferences: IEEE, SPIE, Optica, and ACM, with member rates at conferences and a student branch on campus.';
---

<figure class="eep-fig wide eep-soc-fig" id="fig-20-1">
	<p class="eep-kicker">Which society for which goal</p>
	<p class="sr-only">{alt}</p>
	<div class="eep-soc not-content" aria-hidden="true">
		<ol>
			{groups.map((g) => (
				<li>
					<p class="eep-soc-goal">{g.goal}</p>
					<ul>
						{g.societies.map((s) => (
							<li>{s}</li>
						))}
					</ul>
					<p class="eep-soc-note">{g.note}</p>
				</li>
			))}
		</ol>
	</div>
	<figcaption>
		<span class="eep-fignum">Fig 20.1</span>{' '}
		<span>
			Pick by what you want from it. The sections below give each society's
			student price and what it gives you for the job search.
		</span>
	</figcaption>
</figure>

<style>
	.eep-soc {
		margin-top: 1rem;
		container-type: inline-size;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
		--tint: color-mix(in srgb, var(--eep-dg-ink) 6%, var(--eep-dg-fill));
	}
	.eep-soc p {
		margin: 0;
		max-width: none;
		overflow-wrap: anywhere;
	}
	.eep-soc > ol {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.eep-soc > ol > li {
		display: grid;
		gap: 0.4rem;
		align-content: start;
		margin: 0;
		max-width: none;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--eep-dg-mute);
		border-radius: 4px;
		background: var(--tint);
	}
	.eep-soc-goal {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.eep-soc ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.eep-soc ul li {
		margin: 0;
		padding: 0.15rem 0.5rem;
		border: 1px solid var(--eep-dg-ink);
		border-radius: 4px;
		font-size: 0.8125rem;
		line-height: 1.35;
	}
	.eep-soc-note {
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
	@container (min-width: 36rem) {
		.eep-soc > ol {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
