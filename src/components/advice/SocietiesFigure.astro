---
// Figure 20.1 as HTML and CSS. Which society fits which goal, in three
// columns. Every column gets the same box, and the page text says what each
// one gives.
const groups = [
	{
		goal: 'Scholarships and chapter events',
		societies: ['IEEE-HKN', 'Tau Beta Pi'],
		note: 'By invitation, from grades. Membership for life.',
	},
	{
		goal: 'A large career fair',
		societies: ['SWE', 'NSBE', 'SHPE'],
		note: 'Each runs one at its yearly convention.',
	},
	{
		goal: 'Conferences in your field',
		societies: ['IEEE', 'SPIE', 'Optica', 'ACM'],
		note: 'Join the society whose conference the people in your field attend. IEEE also has student branches at many schools.',
	},
];
const alt =
	'Three groups. For scholarships and chapter events: IEEE-HKN and Tau Beta Pi, by invitation from grades, with membership for life. For a large career fair: SWE, NSBE, and SHPE, which each run one at a yearly convention. For conferences in your field: IEEE, SPIE, Optica, and ACM. Join the society whose conference the people in your field attend, and IEEE also has student branches at many schools.';
---

<figure class="eep-fig wide eep-soc-fig" id="fig-20-1">
	<p class="eep-kicker">Which society for which goal</p>
	<p class="sr-only">{alt}</p>
	<div class="eep-soc not-content" aria-hidden="true">
		<ol>
			{groups.map((g) => (
				<li>
					<p class="eep-soc-goal">{g.goal}</p>
					<ul>
						{g.societies.map((s) => (
							<li>{s}</li>
						))}
					</ul>
					<p class="eep-soc-note">{g.note}</p>
				</li>
			))}
		</ol>
	</div>
	<figcaption>
		<span class="eep-fignum"></span>{' '}
		<span>
			Pick by what you want from it. The sections below say what each society
			gives you for the job search.
		</span>
	</figcaption>
</figure>

<style>
	.eep-soc {
		margin-top: 1rem;
		container-type: inline-size;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
	}
	.eep-soc p {
		margin: 0;
		max-width: none;
		overflow-wrap: anywhere;
	}
	.eep-soc > ol {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.eep-soc > ol > li {
		display: grid;
		gap: 0.4rem;
		align-content: start;
		margin: 0;
		max-width: none;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--eep-dg-mute);
		border-radius: var(--eep-radius);
		background: var(--eep-dg-tint);
	}
	.eep-soc-goal {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.eep-soc ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.eep-soc ul li {
		margin: 0;
		padding: 0.15rem 0.5rem;
		border: 1px solid var(--eep-dg-ink);
		border-radius: var(--eep-radius);
		font-size: 0.8125rem;
		line-height: 1.35;
	}
	.eep-soc-note {
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
	@container (min-width: 36rem) {
		.eep-soc > ol {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
