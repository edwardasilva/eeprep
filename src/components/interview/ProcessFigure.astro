---
// Figure 7.1 as HTML and CSS. On narrow figures the steps hang off one line
// down the left side. On wide ones they run left to right in two rows, and
// the line turns down the right edge from step 5 to step 6.
const steps = [
	{ title: 'Apply', body: 'Day one, no referral' },
	{ title: 'Round 1', body: 'Recruiter phone screen' },
	{ title: 'Round 2', body: 'Phone screen' },
	{ title: 'Take-home', body: '3 hours, no AI tools' },
	{ title: 'Round 3', body: 'Manager call, 30 minutes' },
	{ title: 'Round 4', body: 'In-person day, 6 to 7 hours', focus: true },
	{ title: 'Round 5', body: 'Senior leader call, 30 minutes' },
	{ title: 'Round 6', body: 'Senior leader call, 30 minutes' },
	{ title: 'Offer' },
];
const alt =
	'Timeline of a hiring process. Apply on day one with no referral, a recruiter screen, a phone screen, a 3-hour take-home test, a 30-minute manager call, a 6 to 7 hour in-person day, two 30-minute senior leader calls, then an offer.';
const arrow = 'M1 1.5L9 5L1 8.5Z';
---

<figure class="eep-fig wide eep-proc-fig" id="fig-7-1">
	<p class="eep-kicker">The full process</p>
	<p class="sr-only">{alt}</p>
	<div class="eep-proc not-content" aria-hidden="true">
		<ol class="eep-proc-steps">
			{steps.map((s, i) => (
				<li
					class:list={[
						'eep-proc-step',
						`eep-proc-s${i + 1}`,
						{ 'eep-proc-focus': s.focus, 'eep-proc-end': !s.body },
					]}
				>
					<p class="eep-proc-title">{s.title}</p>
					{s.body && <p class="eep-proc-body">{s.body}</p>}
					{i !== 4 && i !== 8 && (
						<svg class="eep-proc-arrow" viewBox="0 0 10 10" focusable="false">
							<path d={arrow} />
						</svg>
					)}
				</li>
			))}
			<li class="eep-proc-turn">
				<svg class="eep-proc-arrow" viewBox="0 0 10 10" focusable="false">
					<path d={arrow} />
				</svg>
			</li>
		</ol>
	</div>
	<figcaption>
		<span class="eep-fignum">Fig 7.1</span>{' '}
		<span>
			One real hiring process at a large aerospace hardware company: 6 rounds
			plus a take-home test. From eeprep's author.
		</span>
	</figcaption>
</figure>

<style>
	.eep-proc-fig .eep-kicker {
		line-height: 1.35;
	}
	.eep-proc {
		margin-top: 1rem;
		--line: 1.5px;
		--node: 0.8rem;
		--lane: 1rem;
		container-type: inline-size;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
	}
	.eep-proc p {
		margin: 0;
		max-width: none;
	}
	.eep-proc ol {
		position: relative;
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.eep-proc li {
		margin: 0;
		max-width: none;
	}
	.eep-proc .eep-proc-title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
		text-wrap: balance;
	}
	.eep-proc .eep-proc-body {
		margin-top: 0.2rem;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}

	/* Nodes: an open ring for each step, a crimson target on the in-person
	   day and a filled dot at the offer. */
	.eep-proc-step {
		position: relative;
		padding-left: 1.6rem;
	}
	.eep-proc-step::before {
		content: '';
		position: absolute;
		z-index: 1;
		top: 0.2rem;
		left: 0;
		box-sizing: border-box;
		width: var(--node);
		height: var(--node);
		border: var(--line) solid var(--eep-dg-ink);
		border-radius: 50%;
		background: var(--eep-dg-fill);
	}
	.eep-proc-focus::before {
		top: 0.075rem;
		left: -0.125rem;
		width: 1.05rem;
		height: 1.05rem;
		border: 2px solid var(--eep-dg-accent);
		background: radial-gradient(
			circle,
			var(--eep-dg-accent) 0 0.2rem,
			var(--eep-dg-fill) 0.22rem
		);
	}
	.eep-proc-end::before {
		background: var(--eep-dg-ink);
	}

	/* Narrow: one line down the left side. */
	.eep-proc ol::before {
		content: '';
		position: absolute;
		top: 0.5rem;
		bottom: 1rem;
		left: calc(var(--node) / 2 - var(--line) / 2);
		border-left: var(--line) solid var(--eep-dg-ink);
	}
	.eep-proc-arrow,
	.eep-proc-turn {
		display: none;
	}

	/* Wide: two rows, 1 to 5 and 6 to 9, read left to right. */
	@container (min-width: 36rem) {
		.eep-proc ol {
			grid-template-columns: repeat(5, minmax(0, 1fr));
			gap: 0 0.75rem;
			padding-right: var(--lane);
		}
		.eep-proc ol::before {
			display: none;
		}
		.eep-proc-step {
			padding: 1.35rem 0 0;
		}
		.eep-proc-step::before {
			top: 0;
			left: 0;
		}
		.eep-proc-focus::before {
			top: -0.125rem;
			left: -0.125rem;
		}
		.eep-proc-s6,
		.eep-proc-s7,
		.eep-proc-s8,
		.eep-proc-s9 {
			grid-row: 3;
		}
		/* The path line and its arrowhead run to the next node. */
		.eep-proc-step:not(.eep-proc-s5, .eep-proc-end)::after {
			content: '';
			position: absolute;
			top: calc(var(--node) / 2 - var(--line) / 2);
			left: var(--node);
			right: -0.4rem;
			height: var(--line);
			background: var(--eep-dg-ink);
		}
		.eep-proc-step .eep-proc-arrow {
			display: block;
			position: absolute;
			top: calc(var(--node) / 2 - 0.3rem);
			right: -0.75rem;
			width: 0.6rem;
			height: 0.6rem;
			fill: var(--eep-dg-ink);
		}
		/* Step 5 runs right into the lane and down to the turn. */
		.eep-proc-s5::after {
			content: '';
			position: absolute;
			top: calc(var(--node) / 2 - var(--line) / 2);
			left: var(--node);
			right: calc(var(--lane) / -2);
			bottom: 0;
			border-top: var(--line) solid var(--eep-dg-ink);
			border-right: var(--line) solid var(--eep-dg-ink);
			border-top-right-radius: 4px;
		}
		/* The turn runs back left and drops onto step 6. */
		.eep-proc-turn {
			display: block;
			position: relative;
			grid-row: 2;
			grid-column: 1 / -1;
			height: 1.75rem;
		}
		.eep-proc-turn::before {
			content: '';
			position: absolute;
			top: 0;
			left: calc(var(--node) / 2 - var(--line) / 2);
			right: calc(var(--lane) / -2);
			height: 50%;
			border-right: var(--line) solid var(--eep-dg-ink);
			border-bottom: var(--line) solid var(--eep-dg-ink);
			border-bottom-right-radius: 4px;
		}
		.eep-proc-turn::after {
			content: '';
			position: absolute;
			top: calc(50% - var(--line));
			bottom: 0.45rem;
			left: calc(var(--node) / 2 - var(--line) / 2);
			border-left: var(--line) solid var(--eep-dg-ink);
		}
		.eep-proc-turn .eep-proc-arrow {
			display: block;
			position: absolute;
			bottom: 0.15rem;
			left: calc(var(--node) / 2 - 0.3rem);
			width: 0.6rem;
			height: 0.6rem;
			fill: var(--eep-dg-ink);
			transform: rotate(90deg);
		}
	}
</style>
