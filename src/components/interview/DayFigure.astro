---
// Figure 7.4 as HTML and CSS. One schedule down a line on the left. Dashed
// blocks are the informal parts of the day, which still counted.
const blocks = [
	{ title: 'Site tour', tag: 'Still evaluated' },
	{ title: 'Talk on internship work', body: '1 hour, six engineers' },
	{ title: 'System design, whiteboard', body: 'About 1 hour' },
	{
		title: 'Project questions, whiteboard',
		body: 'About 1 hour',
	},
	{ title: 'Lunch', tag: 'Still evaluated' },
	{ title: 'Coding problem, whiteboard', body: 'About 1 hour' },
	{ title: 'Hiring manager', body: 'About 1 hour' },
];
const alt =
	'Schedule of a 6- to 7-hour in-person interview day: a site tour, a one-hour talk to six engineers, system design and project question sessions at a whiteboard, lunch, a whiteboard coding problem, and a hiring manager session. The tour and lunch are marked as still evaluated.';
---

<figure class="eep-fig wide eep-day-fig" id="fig-7-4">
	<p class="eep-kicker">The in-person day</p>
	<p class="sr-only">{alt}</p>
	<div class="eep-day not-content" aria-hidden="true">
		<ol>
			{blocks.map((b) => (
				<li class:list={['eep-day-block', { 'eep-day-informal': b.tag }]}>
					<p class="eep-day-title">{b.title}</p>
					{b.tag ? (
						<p class="eep-day-tag">{b.tag}</p>
					) : (
						<p class="eep-day-body">{b.body}</p>
					)}
				</li>
			))}
		</ol>
		<p class="eep-day-total">5 sessions, 6 to 7 hours</p>
	</div>
	<figcaption>
		<span class="eep-fignum"></span>{' '}
		<span>
			My in-person day. Every session ran about an hour, and the informal parts
			counted too.
		</span>
	</figcaption>
</figure>

<style>
	.eep-day-fig .eep-kicker {
		line-height: 1.35;
	}
	.eep-day {
		margin-top: 1rem;
		--line: 1.5px;
		--node: 0.8rem;
		--rail: 1.6rem;
		container-type: inline-size;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
	}
	.eep-day p {
		margin: 0;
		max-width: none;
	}
	.eep-day ol {
		position: relative;
		display: grid;
		gap: 0.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.eep-day li {
		margin: 0;
		max-width: none;
	}
	.eep-day .eep-day-block {
		position: relative;
		margin-left: var(--rail);
		padding: 0.55rem var(--pad-x, 0.75rem) 0.6rem;
		--b: 1px;
		border: var(--b) solid var(--eep-dg-mute);
		border-radius: 4px;
		background: color-mix(in srgb, var(--eep-dg-ink) 6%, var(--eep-dg-fill));
	}
	.eep-day-block::before {
		content: '';
		position: absolute;
		z-index: 1;
		top: 0.75rem;
		left: calc(-1 * var(--rail) - var(--b));
		box-sizing: border-box;
		width: var(--node);
		height: var(--node);
		border: var(--line) solid var(--eep-dg-ink);
		border-radius: 50%;
		background: var(--eep-dg-fill);
	}
	/* The time line: one segment from each dot to the next, so it ends at
	   the last dot. */
	.eep-day .eep-day-block:not(:last-child)::after {
		content: '';
		position: absolute;
		top: calc(0.75rem + var(--node) / 2);
		left: calc(-1 * var(--rail) - var(--b) + var(--node) / 2 - var(--line) / 2);
		height: calc(100% + 2 * var(--b) + 0.6rem);
		border-left: var(--line) solid var(--eep-dg-ink);
	}
	.eep-day .eep-day-informal {
		--b: var(--line);
		border-style: dashed;
		border-color: var(--eep-dg-ink);
		background: transparent;
	}
	.eep-day .eep-day-title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
		text-wrap: balance;
	}
	.eep-day .eep-day-body {
		margin-top: 0.15rem;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
	.eep-day .eep-day-tag {
		margin-top: 0.2rem;
		font: 0.75rem/1.4 var(--eep-font-serif);
		color: var(--eep-ink-2);
	}
	.eep-day .eep-day-total {
		margin-top: 0.9rem;
		padding-top: 0.6rem;
		border-top: 1px solid var(--eep-dg-mute);
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.45;
	}

	/* Zoomed in on a phone, the blocks sit closer to the line and keep more
	   room for their text. */
	@media (max-width: 19.75rem) {
		.eep-day {
			--rail: 1.1rem;
			--pad-x: 0.4rem;
		}
		.eep-day .eep-day-title {
			font-size: 0.875rem;
		}
	}

	/* Wide: label on the left, length on the right of the same row. */
	@container (min-width: 30rem) {
		.eep-day-block {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 1rem;
			align-items: baseline;
		}
		.eep-day .eep-day-body,
		.eep-day .eep-day-tag {
			margin-top: 0;
			text-align: right;
		}
	}
</style>
