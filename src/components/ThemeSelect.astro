---
// Sun/moon button. With no saved choice, ThemeProvider follows the device.
---

<button class="eep-theme" type="button" aria-label="Switch color theme">
	<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
		<circle
			cx="12"
			cy="12"
			r="4"
			fill="none"
			stroke="currentColor"
			stroke-width="1.75"
		></circle>
		<path
			fill="none"
			stroke="currentColor"
			stroke-width="1.75"
			stroke-linecap="round"
			d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"
		></path>
	</svg>
	<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
		<path
			fill="none"
			stroke="currentColor"
			stroke-width="1.75"
			stroke-linejoin="round"
			d="M16 3.5A8.5 8.5 0 1 0 20.5 14 6.5 6.5 0 0 1 16 3.5z"
		></path>
	</svg>
</button>

<script>
	const storageKey = 'starlight-theme';

	function themeButtons(): HTMLButtonElement[] {
		return [...document.querySelectorAll('.eep-theme')].filter(
			(node): node is HTMLButtonElement => node instanceof HTMLButtonElement,
		);
	}

	function currentTheme(): 'light' | 'dark' {
		return document.documentElement.dataset.theme === 'light'
			? 'light'
			: 'dark';
	}

	function labelFor(theme: 'light' | 'dark'): string {
		return theme === 'light' ? 'Switch to dark' : 'Switch to light';
	}

	function applyTheme(theme: 'light' | 'dark'): void {
		document.documentElement.dataset.theme = theme;
		localStorage.setItem(storageKey, theme);
		for (const button of themeButtons())
			button.setAttribute('aria-label', labelFor(theme));
	}

	for (const button of themeButtons()) {
		if (button.dataset.bound === 'true') continue;
		button.dataset.bound = 'true';
		button.addEventListener('click', () => {
			applyTheme(currentTheme() === 'light' ? 'dark' : 'light');
		});
		button.setAttribute('aria-label', labelFor(currentTheme()));
	}
</script>
