---
// Figure 15.1 as HTML and CSS. The four steps of the author's path, as four
// equal cards. Each card is one thing the text below says, and no more.
// Employers stay unnamed, as on the rest of the page.
const work = [
	{
		title: 'Computer science to EE',
		body: 'I moved to electrical engineering in my second year. Circuits and digital logic made me prefer hardware.',
	},
	{
		title: 'A co-op that did not fit',
		body: 'A six-month design co-op on residential buildings told me which roles to skip.',
	},
	{
		title: 'An internship that did',
		body: 'Real-time signal processing in C++ pointed me at embedded software.',
	},
	{
		title: 'Hundreds of applications, a rebuilt resume',
		body: 'I sent hundreds of applications by hand in the fall of senior year, and rebuilt my early resumes on a better template.',
	},
];
const alt =
	'Four cards describing the path. Computer science to EE in the second year. A six-month design co-op that did not fit. A signal processing internship that did. Hundreds of applications sent by hand, and a resume rebuilt on a better template.';
---

<figure class="eep-fig wide eep-path-fig" id="fig-15-1">
	<p class="eep-kicker">The path in four steps</p>
	<p class="sr-only">{alt}</p>
	<div class="eep-path not-content" aria-hidden="true">
		<ul>
			{work.map((w) => (
				<li>
					<p class="eep-path-title">{w.title}</p>
					<p class="eep-path-body">{w.body}</p>
				</li>
			))}
		</ul>
	</div>
	<figcaption>
		<span class="eep-fignum"></span>{' '}
		<span>Where the advice comes from. The sections below tell it in order.</span>
	</figcaption>
</figure>

<style>
	.eep-path-fig .eep-kicker {
		line-height: 1.35;
	}
	.eep-path {
		margin-top: 1rem;
		container-type: inline-size;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
	}
	.eep-path p {
		margin: 0;
		max-width: none;
	}
	.eep-path ul {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.eep-path li {
		display: grid;
		gap: 0.3rem;
		align-content: start;
		margin: 0;
		max-width: none;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--eep-dg-mute);
		border-radius: 4px;
		background: var(--eep-dg-tint);
	}
	.eep-path-title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
		text-wrap: balance;
	}
	.eep-path-body {
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
	@container (min-width: 30rem) {
		.eep-path ul {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
