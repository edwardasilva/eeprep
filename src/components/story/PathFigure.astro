---
// The work behind the author's path, as six
// equal cards, so the reader sees what went in rather than a calendar. Each
// card is one thing the text above describes. Employers stay unnamed, as on
// the rest of the page.
const work = [
	{
		title: 'Jobs before engineering',
		body: 'Customer service, coding camps, flower deliveries, substitute teaching, and calculus grading. None of it was engineering. All of it taught me to talk to anyone.',
	},
	{
		title: 'Summer classes',
		body: 'Every summer I could not find an internship, I took classes instead. That room is what let me switch majors without adding a year.',
	},
	{
		title: 'Two tries at the field',
		body: 'A six-month electrical design co-op showed me the work I did not want. A signal processing internship right after it showed me the work I did.',
	},
	{
		title: '38 credits in senior year',
		body: '19 credits a semester to catch up after the co-op, with electives picked by interest: DSP, controls, estimation, and a computer built from logic gates up.',
	},
	{
		title: 'A resume rebuilt',
		body: 'The early drafts had the wrong format and the wrong words. The wiki template fixed both, and the rule of 20 came out of the quiet months before that.',
	},
	{
		title: 'Hundreds of applications, by hand',
		body: 'Found mostly on LinkedIn, applied on each company site, with a scraper to catch new postings. The one that landed was a cold application on day one.',
	},
];
const alt =
	'Six cards describing the work behind the path. Jobs before engineering: customer service, coding camps, flower deliveries, substitute teaching, and calculus grading. Summer classes every summer without an internship, which made room to switch majors. Two tries at the field: a six-month design co-op that did not fit and a signal processing internship that did. 38 credits in senior year, with electives picked by interest. A resume rebuilt on the wiki template after quiet months. Hundreds of applications sent by hand, with the job landing from a cold application on day one.';
---

<figure class="eep-fig wide eep-path-fig" id="fig-15-1">
	<p class="eep-kicker">The work behind the path</p>
	<p class="sr-only">{alt}</p>
	<div class="eep-path not-content" aria-hidden="true">
		<ul>
			{work.map((w) => (
				<li>
					<p class="eep-path-title">{w.title}</p>
					<p class="eep-path-body">{w.body}</p>
				</li>
			))}
		</ul>
	</div>
	<figcaption>
		<span class="eep-fignum"></span>{' '}
		<span>What the four years took. The text above tells it in order.</span>
	</figcaption>
</figure>

<style>
	.eep-path-fig .eep-kicker {
		line-height: 1.35;
	}
	.eep-path {
		margin-top: 1rem;
		container-type: inline-size;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
	}
	.eep-path p {
		margin: 0;
		max-width: none;
	}
	.eep-path ul {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.eep-path li {
		display: grid;
		gap: 0.3rem;
		align-content: start;
		margin: 0;
		max-width: none;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--eep-dg-mute);
		border-radius: 4px;
		background: var(--eep-dg-tint);
	}
	.eep-path-title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
		text-wrap: balance;
	}
	.eep-path-body {
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
	@container (min-width: 30rem) {
		.eep-path ul {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@container (min-width: 44rem) {
		.eep-path ul {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
