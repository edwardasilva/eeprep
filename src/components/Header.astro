---
import config from 'virtual:starlight/user-config';

import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind ||
	config.components.Search !== '@astrojs/starlight/components/Search.astro';

const links = [
	{ href: '/advice/resume/', label: 'Advice', section: '/advice/' },
	{ href: '/help-links/', label: 'Help links', section: '/help-links/' },
	{ href: '/roadmap/', label: 'Roadmap', section: '/roadmap/' },
];

const suggestions = [
	{ href: '/advice/resume/', label: 'Resume' },
	{ href: '/advice/first-internship/', label: 'Your first internship' },
	{ href: '/help-links/', label: 'Help links' },
	{ href: '/roadmap/', label: 'Roadmap' },
];

const pathname = Astro.url.pathname;

function isCurrent(section: string): boolean {
	return pathname.startsWith(section);
}
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<nav class="eep-nav" aria-label="Sections">
		{links.map((link) => (
			<a
				href={link.href}
				aria-current={isCurrent(link.section) ? 'page' : undefined}
			>
				{link.label}
			</a>
		))}
	</nav>
	<div class="sl-flex print:hidden">{shouldRenderSearch && <Search />}</div>
	<div class="sl-flex print:hidden right-group">
		<ThemeSelect />
	</div>
</div>

<template id="eep-suggest-template">
	<nav class="eep-suggest" aria-label="Suggested pages">
		<p>Suggested pages</p>
		<ul>
			{suggestions.map((s) => (
				<li>
					<a href={s.href}>{s.label}</a>
				</li>
			))}
		</ul>
	</nav>
</template>

<script>
	// Show suggested pages in the search dialog while the query is empty.
	const dialog = document.querySelector('site-search dialog');
	const template = document.querySelector<HTMLTemplateElement>(
		'#eep-suggest-template',
	);
	const container = dialog?.querySelector('.search-container');
	if (dialog && template && container) {
		const node = template.content.firstElementChild!.cloneNode(true);
		container.append(node);
		const box = node as HTMLElement;
		const update = () => {
			const input = dialog.querySelector('input');
			box.hidden = Boolean(input?.value.trim());
		};
		dialog.addEventListener('input', update);
		new MutationObserver(update).observe(dialog, { attributes: true });
	}
</script>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.right-group {
			gap: 1rem;
			align-items: center;
		}

		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				--__sidebar-width: max(
					0rem,
					var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x)
				);
				--__main-column-fr: calc(
					(
							100% + var(--__sidebar-pad, 0rem) -
								var(--__toc-width, var(--sl-sidebar-width)) -
								(2 * var(--__toc-width, var(--sl-nav-pad-x))) -
								var(--sl-content-inline-start, 0rem) - var(--sl-content-width)
						) /
						2
				);
				display: grid;
				grid-template-columns:
					minmax(
						calc(
							var(--__sidebar-width) +
								max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))
						),
						auto
					)
					auto
					1fr
					auto;
				align-content: center;
			}
		}
	}
</style>
