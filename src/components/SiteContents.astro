---
// The table of contents: every page in sidebar order, with its headings,
// figures, and tables in one list. Pages come from the sidebar, so a new page
// appears here with no edit. Headings, figures, and tables come from the page
// sources (see src/lib/site-index.mjs), and figure numbers from
// src/lib/figure-numbers.ts. The filter narrows the list by words and by kind.
// It reads ?q= and ?show= from the address, so /sitemap/figures/ and
// /sitemap/tables/ can redirect to a filtered view. Without JavaScript the
// whole list shows.
import path from 'node:path';
import { getCollection } from 'astro:content';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';
import { headingsOf, itemsOf } from '../lib/site-index.mjs';
import { figureStarts } from '../lib/figure-numbers';

type Entry = StarlightRouteData['sidebar'][number];
type Kind = 'heading' | 'figure' | 'table';

interface Item {
	kind: Kind;
	text: string;
	href: string;
	tag: string;
	sub: boolean;
}

interface Page {
	label: string;
	href: string;
	items: Item[];
}

const docs = new Map<string, { body: string; file: string }>();
for (const doc of await getCollection('docs')) {
	docs.set(doc.id, {
		body: doc.body ?? '',
		file: path.resolve(doc.filePath ?? ''),
	});
}

const sidebar = Astro.locals.starlightRoute.sidebar;
const starts = await figureStarts(sidebar);
const pages: Page[] = [];
const walk = (entries: Entry[]) => {
	for (const entry of entries) {
		if (entry.type === 'group') {
			walk(entry.entries);
			continue;
		}
		const doc = docs.get(entry.href.replace(/^\/|\/$/g, ''));
		if (!doc) throw new Error(`SiteContents: no docs page for "${entry.href}"`);
		const { figures, tables } = itemsOf(doc.body, doc.file);
		const first = starts.get(entry.href) ?? 0;
		pages.push({
			label: entry.label,
			href: entry.href,
			items: [
				...headingsOf(doc.body).map((h) => ({
					kind: 'heading' as const,
					text: h.text,
					href: `${entry.href}#${h.id}`,
					tag: '',
					sub: h.level === 3,
				})),
				...figures.map((f, i) => ({
					kind: 'figure' as const,
					text: f.title,
					href: `${entry.href}#${f.id}`,
					tag: `Figure ${first + i + 1}`,
					sub: false,
				})),
				...tables.map((t) => ({
					kind: 'table' as const,
					text: t.title ?? entry.label,
					href: t.id ? `${entry.href}#${t.id}` : entry.href,
					tag: 'Table',
					sub: false,
				})),
			],
		});
	}
};
walk(sidebar);

const count = (kind: Kind) =>
	pages.reduce((n, p) => n + p.items.filter((i) => i.kind === kind).length, 0);
const kinds = [
	{ value: 'heading', label: 'Headings', total: count('heading') },
	{ value: 'figure', label: 'Figures', total: count('figure') },
	{ value: 'table', label: 'Tables', total: count('table') },
];
---

<div class="eep-toc" data-site-contents>
	<form
		class="eep-toc-form not-content"
		aria-label="Filter the table of contents"
	>
		<div class="eep-toc-search">
			<label for="eep-toc-q">Search</label>
			<input
				id="eep-toc-q"
				type="search"
				name="q"
				autocomplete="off"
				spellcheck="false"
			/>
		</div>
		<fieldset class="eep-toc-kinds">
			<legend>Show</legend>
			{kinds.map((k) => (
				<label>
					<input type="checkbox" name="kind" value={k.value} checked />
					{k.label} ({k.total})
				</label>
			))}
		</fieldset>
		<div class="eep-toc-tools">
			<p class="eep-toc-count" data-result-count aria-live="polite">
				{pages.length} pages
			</p>
			<button type="reset">Clear filters</button>
		</div>
		<noscript>
			<p>Search and filters need JavaScript. The full list is below.</p>
		</noscript>
	</form>
	{pages.map((page) => (
		<section class="eep-toc-page" data-text={page.label.toLowerCase()}>
			<h2>
				<a href={page.href}>{page.label}</a>
			</h2>
			{page.items.length > 0 && (
				<ul>
					{page.items.map((item) => (
						<li
							class:list={[{ sub: item.sub }]}
							data-kind={item.kind}
							data-text={`${item.tag} ${item.text}`.toLowerCase()}
						>
							<a href={item.href}>{item.text}</a>{' '}
							{item.tag && <span class="eep-toc-tag">({item.tag})</span>}
						</li>
					))}
				</ul>
			)}
		</section>
	))}
	<p class="eep-toc-none" data-no-results hidden>
		Nothing matches. Clear the filters to see every page.
	</p>
</div>

<script>
	const root = document.querySelector('[data-site-contents]');

	if (root instanceof HTMLElement) {
		const form = root.querySelector('form');
		const search = root.querySelector('#eep-toc-q');
		const boxes = [
			...root.querySelectorAll<HTMLInputElement>('input[name="kind"]'),
		];
		const pages = [...root.querySelectorAll<HTMLElement>('.eep-toc-page')];
		const count = root.querySelector('[data-result-count]');
		const none = root.querySelector('[data-no-results]');
		const total = pages.length;

		const params = new URLSearchParams(window.location.search);
		const show = (params.get('show') ?? '')
			.split(',')
			.map((s) => s.trim().replace(/s$/, ''))
			.filter(Boolean);
		if (show.length > 0) {
			for (const box of boxes) {
				box.checked = show.includes(box.value);
			}
		}
		if (search instanceof HTMLInputElement && params.get('q')) {
			search.value = params.get('q') ?? '';
		}

		const apply = () => {
			const words =
				search instanceof HTMLInputElement
					? search.value.trim().toLowerCase().split(/\s+/).filter(Boolean)
					: [];
			const kinds = new Set(boxes.filter((b) => b.checked).map((b) => b.value));
			const allKinds = kinds.size === boxes.length;
			let shownPages = 0;
			let shownItems = 0;
			for (const page of pages) {
				const pageMatch = words.every((w) =>
					(page.dataset.text ?? '').includes(w),
				);
				let visible = 0;
				for (const item of page.querySelectorAll<HTMLElement>('li')) {
					const match =
						kinds.has(item.dataset.kind ?? '') &&
						(pageMatch ||
							words.every((w) => (item.dataset.text ?? '').includes(w)));
					item.hidden = !match;
					if (match) {
						visible += 1;
					}
				}
				const list = page.querySelector('ul');
				if (list) {
					list.hidden = visible === 0;
				}
				const showPage =
					visible > 0 || (pageMatch && (words.length > 0 || allKinds));
				page.hidden = !showPage;
				if (showPage) {
					shownPages += 1;
					shownItems += visible;
				}
			}
			const filtered = words.length > 0 || !allKinds;
			if (count instanceof HTMLElement) {
				const entries = shownItems === 1 ? 'entry' : 'entries';
				count.textContent = filtered
					? `${shownPages} of ${total} pages, ${shownItems} ${entries}`
					: `${total} pages`;
			}
			if (none instanceof HTMLElement) {
				none.hidden = shownPages > 0;
			}
			const next = new URLSearchParams();
			if (words.length > 0 && search instanceof HTMLInputElement) {
				next.set('q', search.value.trim());
			}
			if (!allKinds) {
				next.set('show', [...kinds].map((k) => `${k}s`).join(','));
			}
			const query = next.toString();
			window.history.replaceState(
				null,
				'',
				`${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash}`,
			);
		};

		form?.addEventListener('input', apply);
		form?.addEventListener('change', apply);
		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			apply();
		});
		form?.addEventListener('reset', () => {
			queueMicrotask(apply);
		});

		apply();
	}
</script>

<style>
	.eep-toc [hidden] {
		display: none !important;
	}
	.eep-toc-form {
		margin: 1.5rem 0 var(--eep-space-5);
	}
	.eep-toc-search {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-bottom: var(--eep-space-4);
	}
	.eep-toc-search label,
	.eep-toc-kinds legend {
		font-size: var(--eep-text-sm);
		line-height: 1.4;
		color: var(--eep-ink-2);
	}
	.eep-toc-kinds {
		display: flex;
		flex-wrap: wrap;
		gap: var(--eep-space-3) var(--eep-space-4);
		margin: 0;
		padding: 0;
		border: 0;
	}
	.eep-toc-kinds legend {
		padding: 0;
		margin-bottom: 0.25rem;
	}
	.eep-toc-kinds label {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--eep-ink);
	}
	.eep-toc-form :is(input[type='search'], button) {
		min-height: 2.5rem;
		padding: 0.35rem 0.65rem;
		border: var(--eep-border);
		border-radius: var(--eep-radius);
		background: var(--eep-surface);
		color: var(--eep-ink);
		font: inherit;
		font-size: max(1rem, 16px);
	}
	.eep-toc-form input[type='search'] {
		box-sizing: border-box;
		width: 100%;
	}
	.eep-toc-form input[type='checkbox'] {
		width: 1.1rem;
		height: 1.1rem;
		accent-color: var(--eep-ink);
	}
	.eep-toc-form button {
		cursor: pointer;
	}
	.eep-toc-form :is(input, button):focus-visible {
		outline: 2px solid var(--eep-accent);
		outline-offset: 2px;
	}
	.eep-toc-tools {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--eep-space-3) var(--eep-space-4);
		margin-top: var(--eep-space-4);
	}
	.eep-toc-count,
	.eep-toc-form noscript p {
		margin: 0;
		font-size: var(--eep-text-sm);
		line-height: 1.4;
		color: var(--eep-ink-2);
	}
	.eep-toc-page + .eep-toc-page {
		margin-top: 1.75rem;
	}
	.eep-toc-page h2 {
		margin: 0 0 0.5rem;
		font: 600 var(--eep-text-h3, 1.25rem) / var(--eep-lh-heading, 1.25)
			var(--eep-font-serif);
	}
	.eep-toc-page ul {
		margin: 0;
		padding-left: 1.25rem;
	}
	.eep-toc-page li.sub {
		margin-left: 1.25rem;
	}
	.eep-toc-tag {
		color: var(--eep-ink-2);
	}
	.eep-toc-none {
		margin-top: var(--eep-space-4);
		color: var(--eep-ink-2);
	}
</style>
