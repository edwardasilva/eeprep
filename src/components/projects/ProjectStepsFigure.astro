---
import { externalLinks } from '../resume/caption';
// Figure 1.2 as HTML and CSS. One column of four steps in the order the page
// opens with. Every step restates a line from the page.
const steps = [
	{
		title: 'Pick one build you can defend',
		body: 'Say why you picked the parts, why the board is laid out that way, and how the circuit works.',
	},
	{
		title: 'Aim it at what the company makes',
		body: 'Build a small version. Skip a second copied kit.',
	},
	{
		title: 'Finish with a measured number',
		body: 'Put the number on the resume line.',
	},
	{
		title: 'Write down what broke',
		body: 'Say how you fixed it, or record a video of the build working.',
	},
];
const alt =
	'Four steps in order. One, pick one build you can defend: say why you picked the parts, why the board is laid out that way, and how the circuit works. Two, aim it at what the company makes: build a small version and skip a second copied kit. Three, finish with a measured number and put it on the resume line. Four, write down what broke and how you fixed it, or record a video of the build working.';
const caption = externalLinks(
	`The steps from the top of this page, in order. Sources: <a href="https://www.reddit.com/r/ElectricalEngineering/comments/1ndmj2u/could_anyone_recommend_a_project_for_ee_majors/">a thread on builds you can explain</a> and <a href="https://www.reddit.com/r/EngineeringStudents/comments/1odiu6l/personal_projects_that_got_you_hired_for/">a thread on projects that got people hired</a>.`,
);
---

<figure class="eep-fig wide eep-pstep-fig" id="fig-1-2">
	<p class="eep-kicker">One project, start to finish</p>
	<p class="sr-only">{alt}</p>
	<div class="eep-pstep not-content" aria-hidden="true">
		<ol>
			{steps.map((s, i) => (
				<li class="eep-pstep-step">
					<span class="eep-num">{i + 1}</span>
					<div>
						<p class="eep-pstep-title">{s.title}</p>
						<p class="eep-pstep-body">{s.body}</p>
					</div>
				</li>
			))}
		</ol>
	</div>
	<figcaption>
		<span class="eep-fignum"></span> <span set:html={caption} />
	</figcaption>
</figure>

<style>
	.eep-pstep {
		margin-top: 1rem;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
	}
	.eep-pstep p {
		margin: 0;
		max-width: none;
		overflow-wrap: anywhere;
	}
	.eep-pstep ol {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.eep-pstep li {
		display: grid;
		grid-template-columns: 1.75rem 1fr;
		gap: 0.75rem;
		align-items: start;
		margin: 0;
		max-width: none;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--eep-dg-mute);
		border-radius: var(--eep-radius);
		background: var(--eep-dg-tint);
	}
	.eep-pstep .eep-pstep-title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.eep-pstep .eep-pstep-body {
		margin-top: 0.2rem;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
</style>
