---
import { externalLinks } from '../resume/caption';
// Figure 3.1 as HTML and CSS. Three boxes in a row on wide figures, stacked on
// narrow ones. They have no numbers because the page does not rank the team
// against the build. The dashed box is the fallback, as in Figure 8.1. Every
// line restates the Hardware page.
const items = [
	{
		title: 'Bench skills',
		body: 'Practice on the lab scope until you can run the oscilloscope and the function generator without help.',
	},
	{
		title: 'One build',
		body: 'Take one project from schematic to bench test. List it with a measured number in each bracket.',
	},
	{
		title: 'Design team',
		body: 'Join a racing or rocket team in your first year. It gives you real work to talk about at a career fair.',
	},
];
const caption = externalLinks(
	`Three things to do before your first internship, and a bridge if design roles are scarce. Sources: <a href="https://x.com/OnosSpeaks/status/2001938854585270650">a post on listing bench tools</a>, <a href="https://www.reddit.com/r/ElectricalEngineering/comments/1puvlji/how_to_not_waste_my_undergrad_2nd_year_with_no/">a thread on design teams</a>, and <a href="https://x.com/SogeKingu2000/status/2090407950410231918">a post on starting as a technician</a>.`,
);
---

<figure class="eep-fig wide eep-proof-fig" id="fig-3-1">
	<p class="eep-kicker">Before your first internship</p>
	<div class="eep-proof not-content">
		<ul>
			{items.map((item) => (
				<li>
					<p class="eep-proof-title">{item.title}</p>
					<p class="eep-proof-body">{item.body}</p>
				</li>
			))}
		</ul>
		<div class="eep-proof-bridge">
			<p class="eep-proof-when">If entry-level design roles are scarce</p>
			<p class="eep-proof-title">Test or technician role</p>
			<p class="eep-proof-body">
				Take one as a bridge. Before you accept, write down the design title you
				still want.
			</p>
		</div>
	</div>
	<figcaption>
		<span class="eep-fignum">Fig 3.1</span> <span set:html={caption} />
	</figcaption>
</figure>

<style>
	.eep-proof {
		margin-top: 1rem;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
		--tint: color-mix(in srgb, var(--eep-dg-ink) 6%, var(--eep-dg-fill));
	}
	.eep-proof p {
		margin: 0;
		max-width: none;
		overflow-wrap: anywhere;
	}
	.eep-proof ul {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.eep-proof li {
		margin: 0;
		max-width: none;
		padding: 0.6rem 0.75rem 0.7rem;
		border: 1px solid var(--eep-dg-mute);
		border-radius: 4px;
		background: var(--tint);
	}
	.eep-proof .eep-proof-title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.eep-proof .eep-proof-body {
		margin-top: 0.2rem;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
	/* Dashed marks a fallback, as it does in Figure 8.1. */
	.eep-proof-bridge {
		margin-top: 0.75rem;
		padding: 0.6rem 0.75rem 0.7rem;
		border: 1px dashed var(--eep-dg-mute);
		border-radius: 4px;
	}
	.eep-proof .eep-proof-when {
		margin-bottom: 0.2rem;
		font: 0.75rem/1.4 var(--eep-font-serif);
		color: var(--eep-ink-2);
	}
</style>
