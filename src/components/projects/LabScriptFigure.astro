---
import { externalLinks } from '../resume/caption';
// Figure 2.1 as HTML and CSS. Four steps of a lab script. On wide figures they
// run left to right. On narrow ones they stack, and the arrows point down.
// Every step restates the Test automation and lab scripts section.
const steps = [
	{
		title: 'Capture',
		body: 'Point PyVISA at a lab scope and capture a waveform.',
	},
	{
		title: 'Compute',
		body: 'Compute the number you would have read by hand.',
	},
	{
		title: 'Check',
		body: 'Put the limits in pytest tests.',
	},
	{
		title: 'Out of spec',
		body: 'A part out of spec fails the run.',
	},
];
const alt =
	'Four steps of a lab script, in order. Capture: point PyVISA at a lab scope and capture a waveform. Compute: compute the number you would have read by hand. Check: put the limits in pytest tests. Out of spec: a part out of spec fails the run.';
const caption = externalLinks(
	`A lab script turns a bench measurement into a test. Sources: <a href="https://pyvisa.readthedocs.io/en/latest/">PyVISA</a> and <a href="https://docs.pytest.org/en/stable/">pytest</a>.`,
);
const arrow = 'M1 1.5L9 5L1 8.5Z';
---

<figure class="eep-fig wide eep-lab-fig" id="fig-2-1">
	<p class="eep-kicker">From bench measurement to test</p>
	<p class="sr-only">{alt}</p>
	<div class="eep-lab not-content" aria-hidden="true">
		<ol>
			{steps.map((s, i) => (
				<li class="eep-lab-step">
					<p class="eep-lab-title">{s.title}</p>
					<p class="eep-lab-body">{s.body}</p>
					{i < steps.length - 1 && (
						<svg class="eep-lab-arrow" viewBox="0 0 10 10" focusable="false">
							<path d={arrow} />
						</svg>
					)}
				</li>
			))}
		</ol>
	</div>
	<figcaption>
		<span class="eep-fignum"></span> <span set:html={caption} />
	</figcaption>
</figure>

<style>
	.eep-lab {
		margin-top: 1rem;
		--gap: 1.5rem;
		container-type: inline-size;
		font-family: var(--eep-font-sans);
		color: var(--eep-ink);
	}
	.eep-lab p {
		margin: 0;
		max-width: none;
		overflow-wrap: anywhere;
	}
	.eep-lab ol {
		display: grid;
		gap: var(--gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.eep-lab li {
		position: relative;
		margin: 0;
		max-width: none;
		padding: 0.6rem 0.75rem;
		border: var(--eep-dg-line) solid var(--eep-dg-mute);
		border-radius: 4px;
		background: var(--eep-dg-tint);
	}
	.eep-lab .eep-lab-title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.eep-lab .eep-lab-body {
		margin-top: 0.2rem;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--eep-ink-2);
	}
	/* Narrow: the arrow sits in the gap under each step and points down. */
	.eep-lab-arrow {
		position: absolute;
		bottom: calc(var(--gap) * -0.75);
		left: 1rem;
		width: 0.75rem;
		height: 0.75rem;
		fill: var(--eep-dg-ink);
		transform: rotate(90deg);
	}
	/* Wide: four columns, and the arrow sits in the gap to the right. */
	@container (min-width: 32rem) {
		.eep-lab ol {
			grid-template-columns: repeat(4, 1fr);
		}
		.eep-lab-arrow {
			top: 50%;
			right: calc(var(--gap) * -0.75);
			bottom: auto;
			left: auto;
			transform: translateY(-50%);
		}
	}
</style>
