# Response headers for every page and file on eeprep.com and the dev site.
# Cloudflare applies this file to static asset responses. The dev deploy adds
# X-Robots-Tag: noindex inside the /* rule (see .github/workflows/deploy.yml).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'

# Astro fingerprints every file in /_astro/, so a changed file gets a new name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
